<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="view_contact_center_whatsapp_cloud_delivery_failure_tree"
        model="ir.ui.view"
    >
        <field name="name">contact.center.whatsapp.cloud.delivery.failure.tree</field>
        <field name="model">contact.center.whatsapp.cloud.delivery.failure</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="occurred_at" />
                <field name="kind" />
                <field name="connection_id" />
                <field name="code" />
                <field name="title" />
                <field name="wamid" optional="hide" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <record
        id="view_contact_center_whatsapp_cloud_delivery_failure_form"
        model="ir.ui.view"
    >
        <field name="name">contact.center.whatsapp.cloud.delivery.failure.form</field>
        <field name="model">contact.center.whatsapp.cloud.delivery.failure</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="kind" />
                            <field name="connection_id" />
                            <field name="account_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group>
                            <field name="occurred_at" />
                            <field name="code" />
                            <field name="title" />
                            <field name="wamid" />
                            <field name="message_binding_id" />
                            <field name="meta_delivery_ref" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record
        id="view_contact_center_whatsapp_cloud_delivery_failure_search"
        model="ir.ui.view"
    >
        <field name="name">contact.center.whatsapp.cloud.delivery.failure.search</field>
        <field name="model">contact.center.whatsapp.cloud.delivery.failure</field>
        <field name="arch" type="xml">
            <search>
                <field name="connection_id" />
                <field name="code" />
                <field name="wamid" />
                <filter
                    name="status_failed"
                    string="Failed Statuses"
                    domain="[('kind', '=', 'status_failed')]"
                />
                <filter
                    name="webhook_error"
                    string="Webhook Errors"
                    domain="[('kind', '=', 'webhook_error')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_code"
                        string="Code"
                        context="{'group_by': 'code'}"
                    />
                    <filter
                        name="group_connection"
                        string="Connection"
                        context="{'group_by': 'connection_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record
        id="action_contact_center_whatsapp_cloud_delivery_failures"
        model="ir.actions.act_window"
    >
        <field name="name">WhatsApp Cloud Failures</field>
        <field name="res_model">contact.center.whatsapp.cloud.delivery.failure</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <menuitem
        id="menu_contact_center_whatsapp_cloud_delivery_failures"
        name="WhatsApp Cloud Failures"
        parent="contact_center_base.menu_contact_center_configuration"
        action="action_contact_center_whatsapp_cloud_delivery_failures"
        sequence="25"
        groups="contact_center_base.group_contact_center_admin"
    />
</odoo>
