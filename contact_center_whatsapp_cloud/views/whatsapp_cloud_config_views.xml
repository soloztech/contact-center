<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_contact_center_connection_form_whatsapp_cloud" model="ir.ui.view">
        <field
            name="name"
        >contact.center.provider.connection.form.whatsapp.cloud</field>
        <field name="model">contact.center.provider.connection</field>
        <field
            name="inherit_id"
            ref="contact_center_base.view_contact_center_connection_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//notebook[@name='provider_configuration_notebook']"
                position="inside"
            >
                <page
                    string="WhatsApp Cloud"
                    attrs="{'invisible': [('adapter_key', '!=', 'whatsapp_cloud')]}"
                    groups="contact_center_base.group_contact_center_admin"
                >
                    <field name="company_id" invisible="1" />
                    <group>
                        <group>
                            <field
                                name="wa_webhook_asset_id"
                                string="WhatsApp Business Account"
                                domain="[('company_id', '=', company_id), ('platform', '=', 'whatsapp'), ('active', '=', True), ('page_id.active', '=', True)]"
                                options="{'no_create': True}"
                                groups="base.group_system"
                                attrs="{'readonly': [('wa_webhook_asset_id', '!=', False)]}"
                            />
                            <field name="wa_business_account_id" readonly="1" />
                            <field
                                name="wa_phone_number_id"
                                attrs="{'readonly': [('id', '!=', False)], 'required': [('adapter_key', '=', 'whatsapp_cloud')]}"
                            />
                            <field name="wa_graph_version" />
                        </group>
                        <group>
                            <field name="wa_webhook_page_id" readonly="1" />
                            <field name="wa_api_app_id" readonly="1" />
                            <field name="wa_display_phone_number" readonly="1" />
                            <field name="wa_verified_name" readonly="1" />
                            <field name="wa_quality_rating" readonly="1" />
                            <field name="wa_phone_status" readonly="1" />
                            <field name="wa_throughput_level" readonly="1" />
                            <field name="wa_observed_at" readonly="1" />
                            <button
                                name="action_whatsapp_cloud_configure_webhook"
                                type="object"
                                string="Register WhatsApp Consumer"
                                icon="fa-random"
                                class="oe_highlight"
                                groups="base.group_system"
                                attrs="{'invisible': [('wa_webhook_asset_id', '=', False)]}"
                            />
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        The business account asset is the single source for App,
                        system-user token reference, callback routing and the webhook
                        ledger. Contact Center stores no WhatsApp secret. Subscribing
                        the App on the business account is an activation step done
                        outside Odoo.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
