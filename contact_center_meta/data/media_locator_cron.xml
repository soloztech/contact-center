<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_contact_center_meta_media_locator_cleanup" model="ir.cron">
        <field name="name">Contact Center: clear expired Meta media locators</field>
        <field name="model_id" ref="model_contact_center_meta_media_locator" />
        <field name="state">code</field>
        <field name="code">model._cron_purge_private_urls()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True" />
    </record>
</odoo>
