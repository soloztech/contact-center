<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_contact_center_connection_form_meta" model="ir.ui.view">
        <field name="name">contact.center.provider.connection.form.meta</field>
        <field name="model">contact.center.provider.connection</field>
        <field
            name="inherit_id"
            ref="contact_center_base.view_contact_center_connection_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//notebook[@name='provider_configuration_notebook']"
                position="inside"
            >
                <page
                    string="Meta"
                    attrs="{'invisible': [('adapter_key', '!=', 'meta')]}"
                    groups="contact_center_base.group_contact_center_admin"
                >
                    <field name="company_id" invisible="1" />
                    <group>
                        <group>
                            <field
                                name="meta_webhook_asset_id"
                                string="Meta Messaging Asset"
                                domain="[('company_id', '=', company_id), ('active', '=', True), ('page_id.active', '=', True)]"
                                options="{'no_create': True}"
                                groups="base.group_system"
                                attrs="{'readonly': [('meta_webhook_asset_id', '!=', False)]}"
                            />
                            <field name="meta_transport_mode" readonly="1" />
                            <field name="meta_target_asset_id" readonly="1" />
                        </group>
                        <group>
                            <field name="meta_webhook_page_id" readonly="1" />
                            <field name="meta_api_app_id" readonly="1" />
                            <button
                                name="action_meta_configure_webhook"
                                type="object"
                                string="Configure Meta Webhook"
                                icon="fa-random"
                                class="oe_highlight"
                                groups="base.group_system"
                                attrs="{'invisible': [('meta_webhook_asset_id', '=', False)]}"
                            />
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        The selected asset is the single source for App, Page,
                        credential references, callback routing and subscriptions.
                        Contact Center stores no Meta secret and no duplicate webhook
                        ledger.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
