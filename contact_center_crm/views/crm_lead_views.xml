<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_crm_lead_form_conversations" model="ir.ui.view">
        <field name="name">crm.lead.form.contact.center.conversations</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_contact_center_conversations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-comments"
                    groups="contact_center_base.group_contact_center_agent"
                    attrs="{'invisible': [('contact_center_conversation_count', '=', 0)]}"
                >
                    <field
                        name="contact_center_conversation_count"
                        widget="statinfo"
                        string="Conversas"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
