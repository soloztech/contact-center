<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_crm_lead_form_conversations" model="ir.ui.view">
        <field name="name">crm.lead.form.contact.center.conversations</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_contact_center_journey"
                    type="object"
                    string="Jornada"
                    groups="contact_center_base.group_contact_center_agent"
                />
                <button
                    name="action_contact_center_converse"
                    type="object"
                    string="Conversar"
                    groups="contact_center_base.group_contact_center_agent"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_contact_center_conversations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-comments"
                    groups="contact_center_base.group_contact_center_agent"
                    attrs="{'invisible': [('contact_center_conversation_count', '=', 0)]}"
                >
                    <field
                        name="contact_center_conversation_count"
                        widget="statinfo"
                        string="Conversas"
                    />
                </button>
            </xpath>
        </field>
    </record>
    <record id="view_crm_start_conversation_form" model="ir.ui.view">
        <field name="name">contact.center.crm.start.form</field>
        <field name="model">contact.center.crm.start</field>
        <field name="arch" type="xml">
            <form string="Conversar">
                <group>
                    <field name="lead_id" />
                    <field name="available_account_ids" invisible="1" />
                    <field
                        name="account_id"
                        domain="[('id', 'in', available_account_ids)]"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field name="phone" />
                </group>
                <p
                >Abre ou reutiliza uma conversa vinculada a este lead. Nenhuma mensagem será enviada automaticamente.</p>
                <footer>
                    <button
                        name="action_start"
                        type="object"
                        string="Abrir conversa"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="view_crm_scope_form" model="ir.ui.view">
        <field name="name">contact.center.crm.scope.form</field>
        <field name="model">contact.center.crm.scope</field>
        <field name="arch" type="xml"><form string="Período comercial">
            <p
                >Confirme somente o período deste negócio. Origens anteriores ao início não recebem crédito. O fim é exclusivo; deixar vazio mantém o período aberto.</p>
            <group><field name="lead_id" /><field name="channel_id" /><field
                        name="scope_start"
                    /><field name="scope_end" /></group>
            <footer><button
                        name="action_confirm"
                        type="object"
                        string="Confirmar período"
                        class="btn-primary"
                    /><button string="Cancelar" special="cancel" /></footer>
        </form></field>
    </record>
</odoo>
