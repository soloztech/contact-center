        <record id="rule_cc_crm_case_link_own" model="ir.rule">
            <field name="name">CRM case links in own Contact Center boxes</field>
            <field name="model_id" ref="model_contact_center_crm_case_link" />
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
            <field
            name="domain_force"
        >[('company_id', 'in', company_ids), ('channel_id.channel_member_ids.partner_id', '=', user.partner_id.id), '|', ('lead_user_id', '=', user.id), ('lead_user_id', '=', False)]</field>
        </record>

        <record id="rule_cc_crm_case_link_all_leads" model="ir.rule">
            <field name="name">CRM case links in accessible Contact Center boxes</field>
            <field name="model_id" ref="model_contact_center_crm_case_link" />
            <field
            name="groups"
            eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"
        />
            <field
            name="domain_force"
        >[('company_id', 'in', company_ids), ('channel_id.channel_member_ids.partner_id', '=', user.partner_id.id)]</field>
        </record>

