<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <record id="rule_cc_crm_team_binding_company" model="ir.rule">
            <field name="name">Contact Center CRM team bindings by company</field>
            <field name="model_id" ref="model_contact_center_crm_team_binding" />
            <field
            name="groups"
            eval="[(4, ref('contact_center_base.group_contact_center_agent'))]"
        />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cc_crm_pipeline_binding_company" model="ir.rule">
            <field name="name">Contact Center CRM pipeline bindings by company</field>
            <field name="model_id" ref="model_contact_center_crm_pipeline_binding" />
            <field
            name="groups"
            eval="[(4, ref('contact_center_base.group_contact_center_agent'))]"
        />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cc_crm_stage_binding_company" model="ir.rule">
