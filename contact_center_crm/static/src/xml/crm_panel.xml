<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="contact_center_crm.CrmPanel" owl="1">
        <aside
            id="cc-crm-panel"
            class="cc-contact-panel cc-crm-panel"
            aria-label="Comercial do cliente"
            t-on-keydown="onKeydown"
        >
            <header class="cc-contact-panel__header cc-crm-panel__header">
                <span class="cc-crm-panel__icon" aria-hidden="true"><i
                        class="fa fa-handshake-o"
                    /></span>
                <div><p class="cc-kicker">Cliente</p><h2>Comercial</h2></div>
                <button
                    t-ref="closeButton"
                    type="button"
                    class="cc-icon-button"
                    aria-label="Fechar comercial do cliente"
                    t-on-click="props.onClose"
                ><i class="fa fa-times" aria-hidden="true" /></button>
            </header>
            <div class="cc-contact-panel__scroll">
                <section
                    class="cc-detail-section cc-crm-panel__customer"
                    t-if="state.partner"
                >
                    <strong t-esc="state.partner.name" />
                    <span
                        t-if="state.company &amp;&amp; state.company.id !== state.partner.id"
                        t-esc="state.company.name"
                    />
                </section>
                <div
                    class="cc-crm-panel__tabs"
                    role="tablist"
                    aria-label="Registros comerciais do cliente"
                >
                    <button
                        t-foreach="state.tabs"
                        t-as="tab"
                        t-key="tab.id"
                        type="button"
                        role="tab"
                        t-att-id="'cc-crm-tab-' + tab.id"
                        t-att-class="tab.available === false ? 'is-unavailable' : ''"
                        t-att-aria-selected="state.activeTab === tab.id ? 'true' : 'false'"
                        t-att-tabindex="state.activeTab === tab.id ? '0' : '-1'"
                        aria-controls="cc-crm-records"
                        t-att-title="tab.available === false ? 'Indisponível: módulo não instalado ou acesso não permitido.' : tab.label"
                        t-on-click="() => model.selectTab(tab.id)"
                        t-on-keydown="onTabKeydown"
                    >
                        <t t-esc="tab.label" /><span
                            t-if="tab.available === false"
                            class="sr-only"
                        > (indisponível)</span>
                    </button>
                </div>
                <section
                    id="cc-crm-records"
                    class="cc-detail-section cc-crm-panel__content"
                    role="tabpanel"
                    t-att-aria-labelledby="'cc-crm-tab-' + state.activeTab"
                    t-att-aria-busy="page.phase === 'loading' ? 'true' : 'false'"
                >
                    <p
                        t-if="state.operationError"
                        class="cc-crm-panel__error"
                        role="alert"
                        t-esc="state.operationError"
                    />
                    <p
                        t-if="page.phase === 'loading' || page.phase === 'idle'"
                        class="cc-detail-copy"
                        role="status"
                    ><i
                            class="fa fa-circle-o-notch fa-spin"
                            aria-hidden="true"
                        /> Carregando registros…</p>
                    <p
                        t-elif="page.phase === 'unavailable'"
                        class="cc-detail-copy"
                        role="status"
                    >Esta aba está indisponível. O módulo necessário não está instalado ou seu usuário não tem acesso a esses registros.</p>
                    <p
                        t-elif="page.phase === 'denied'"
                        class="cc-detail-copy"
                        role="status"
                    >Você não tem acesso aos registros deste cliente.</p>
                    <t t-else="">
                        <form
                            class="cc-crm-panel__search"
                            t-on-submit.prevent="() => model.load()"
                            t-if="page.phase === 'ready' &amp;&amp; state.partner"
                        >
                            <label
                                class="cc-crm-panel__search-label"
                                for="cc-crm-search"
                            >Buscar nesta aba</label>
                            <div><input
                                    id="cc-crm-search"
                                    type="search"
                                    maxlength="128"
                                    placeholder="Nome ou número do registro"
                                    t-model="page.query"
                                />
                                <button
                                    type="submit"
                                    class="cc-icon-button"
                                    aria-label="Buscar registros"
                                ><i class="fa fa-search" aria-hidden="true" /></button>
                            </div>
                        </form>
                        <p
                            t-if="page.error"
                            class="cc-crm-panel__error"
                            role="alert"
                            t-esc="page.error"
                        />
                        <button
                            t-if="page.error"
                            type="button"
                            class="cc-secondary-button"
                            t-on-click="() => model.load()"
                        >Tentar novamente</button>
                        <p
                            t-if="page.phase === 'ready' &amp;&amp; !state.partner"
                            class="cc-detail-copy"
                        >Vincule um contato nos detalhes da conversa para consultar os registros comerciais do cliente e da empresa.</p>
                        <p
                            t-if="page.phase === 'ready' &amp;&amp; state.partner &amp;&amp; !page.items.length &amp;&amp; !page.error"
                            class="cc-detail-copy"
                            role="status"
                            t-esc="page.appliedQuery ? 'Nenhum registro encontrado para esta busca.' : 'Este cliente ainda não tem registros disponíveis nesta aba.'"
                        />
                        <ul class="cc-crm-panel__list" t-if="page.items.length">
                            <li
                                t-foreach="page.items"
                                t-as="item"
                                t-key="item.id"
                                class="cc-customer-record"
                            >
                                <div
                                    t-if="item.type === 'lead' || !item.active || item.type === 'out_refund'"
                                    class="cc-customer-record__markers"
                                >
                                    <span
                                        t-if="item.type === 'lead'"
                                        t-esc="item.typeLabel || 'Lead'"
                                    />
                                    <span t-if="!item.active">Arquivada</span>
                                    <span
                                        t-if="item.type === 'out_refund'"
                                        t-esc="item.typeLabel || 'Nota de crédito'"
                                    />
                                </div>
                                <button
                                    type="button"
                                    class="cc-record-link cc-customer-record__name"
                                    t-on-click="() => model.openRecord(item.id)"
                                    t-att-aria-label="'Abrir registro ' + item.name"
                                ><span t-esc="item.name" /><i
                                        class="fa fa-external-link"
                                        aria-hidden="true"
                                    /></button>
                                <div class="cc-customer-record__summary">
                                    <span
                                        t-if="item.stage || item.state"
                                        t-att-class="item.won ? 'cc-customer-record__state is-won' : 'cc-customer-record__state'"
                                        t-esc="item.stage ? item.stage.name : item.state"
                                    />
                                    <strong
                                        t-if="item.amount !== false"
                                        t-esc="amountLabel(item)"
                                    />
                                </div>
                                <dl class="cc-customer-record__details">
                                    <div t-if="item.date"><dt>Data do registro</dt><dd><time
                                                t-att-datetime="item.date"
                                                t-esc="dateLabel(item)"
                                            /></dd></div>
                                    <div t-if="item.team"><dt>Equipe</dt><dd
                                            t-esc="item.team.name"
                                        /></div>
                                    <div t-if="item.model === 'crm.lead'"><dt
                                        >Vendedor</dt><dd
                                            t-esc="item.user ? item.user.name : 'Sem vendedor'"
                                        /></div>
                                    <div t-if="item.paymentState"><dt>Pagamento</dt><dd
                                            t-esc="item.paymentState"
                                        /></div>
                                </dl>
                            </li>
                        </ul>
                        <button
                            t-if="page.hasMore"
                            type="button"
                            class="cc-secondary-button cc-crm-panel__more"
                            t-att-disabled="page.loadingMore"
                            t-on-click="() => model.load({append: true})"
                        ><i
                                t-if="page.loadingMore"
                                class="fa fa-circle-o-notch fa-spin"
                                aria-hidden="true"
                            /> Carregar mais</button>
                    </t>
                </section>
            </div>
        </aside>
    </t>
</templates>
