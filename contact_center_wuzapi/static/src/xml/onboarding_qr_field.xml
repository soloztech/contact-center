<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="contact_center_wuzapi.ContactCenterOnboardingQrField" owl="1">
        <section class="o_cc_wuzapi_qr" aria-live="polite">
            <t t-if="hasQrCode">
                <div class="o_cc_wuzapi_qr_frame">
                    <img
                        t-att-src="props.value"
                        alt="QR Code para conectar o WhatsApp"
                        draggable="false"
                    />
                </div>
                <div class="o_cc_wuzapi_qr_copy">
                    <strong>Escaneie no WhatsApp</strong>
                    <span>
                        Abra Dispositivos conectados, toque em Conectar dispositivo e
                        leia este código.
                    </span>
                </div>
            </t>
            <div t-else="" class="alert alert-info mb-0" role="status">
                Inicie a conexão para gerar o QR Code.
            </div>
        </section>
    </t>
</templates>
