<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <record id="rule_contact_center_pipeline_company" model="ir.rule">
            <field name="name">Contact Center pipelines by company</field>
            <field name="model_id" ref="model_contact_center_pipeline" />
            <field name="groups" eval="[(4, ref('group_contact_center_agent'))]" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_contact_center_pipeline_stage_company" model="ir.rule">
            <field name="name">Contact Center pipeline stages by company</field>
