        </record>

        <record id="rule_contact_center_case_membership" model="ir.rule">
            <field name="name">Contact Center cases by conversation membership</field>
            <field name="model_id" ref="model_contact_center_case" />
            <field name="groups" eval="[(4, ref('group_contact_center_agent'))]" />
            <field
            name="domain_force"
        >[('company_id', 'in', company_ids), ('channel_id.channel_member_ids.partner_id', '=', user.partner_id.id)]</field>
        </record>

