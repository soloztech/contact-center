<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Supervisors read the conversations they are members of; administrators
         read every conversation of their companies, like the message ledgers. -->
    <record id="rule_contact_center_conversation_event_supervisor" model="ir.rule">
        <field
            name="name"
        >Conversation lifecycle events by supervisor membership</field>
        <field name="model_id" ref="model_contact_center_conversation_event" />
        <field name="groups" eval="[(4, ref('group_contact_center_supervisor'))]" />
        <field
            name="domain_force"
        >[('company_id', 'in', company_ids), ('channel_id.channel_member_ids.partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_contact_center_conversation_event_admin" model="ir.rule">
        <field
            name="name"
        >Conversation lifecycle events by administrator company</field>
        <field name="model_id" ref="model_contact_center_conversation_event" />
        <field name="groups" eval="[(4, ref('group_contact_center_admin'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_contact_center_attendance_episode_supervisor" model="ir.rule">
        <field name="name">Attendance episodes by supervisor membership</field>
        <field name="model_id" ref="model_contact_center_attendance_episode" />
        <field name="groups" eval="[(4, ref('group_contact_center_supervisor'))]" />
        <field
            name="domain_force"
        >[('company_id', 'in', company_ids), ('channel_id.channel_member_ids.partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_contact_center_attendance_episode_admin" model="ir.rule">
        <field name="name">Attendance episodes by administrator company</field>
        <field name="model_id" ref="model_contact_center_attendance_episode" />
        <field name="groups" eval="[(4, ref('group_contact_center_admin'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_contact_center_attendance_message_supervisor" model="ir.rule">
        <field name="name">Attendance messages by supervisor membership</field>
        <field name="model_id" ref="model_contact_center_attendance_message" />
        <field name="groups" eval="[(4, ref('group_contact_center_supervisor'))]" />
        <field
            name="domain_force"
        >[('company_id', 'in', company_ids), ('channel_id.channel_member_ids.partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_contact_center_attendance_message_admin" model="ir.rule">
        <field name="name">Attendance messages by administrator company</field>
        <field name="model_id" ref="model_contact_center_attendance_message" />
        <field name="groups" eval="[(4, ref('group_contact_center_admin'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
