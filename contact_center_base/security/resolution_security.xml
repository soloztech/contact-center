<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="rule_contact_center_resolution_reason_company" model="ir.rule">
        <field name="name">Resolution reasons by company</field>
        <field name="model_id" ref="model_contact_center_resolution_reason" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_contact_center_resolution_request_company" model="ir.rule">
        <field name="name">Resolution receipts by company</field>
        <field name="model_id" ref="model_contact_center_resolution_request" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
