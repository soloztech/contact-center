<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mail_channel_form_contact_center" model="ir.ui.view">
        <field name="name">mail.channel.form.contact.center</field>
        <field name="model">mail.channel</field>
        <field name="inherit_id" ref="mail.mail_channel_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='privacy']" position="after">
                <page
                    string="Contact Center"
                    name="contact_center"
                    attrs="{'invisible': [('channel_type', '!=', 'contact_center')]}"
                >
                    <group>
                        <group>
                            <field name="contact_center_company_id" readonly="1" />
                            <field name="contact_center_team_id" readonly="1" />
                            <field name="contact_center_owner_user_id" readonly="1" />
                            <field name="contact_center_responsible_id" readonly="1" />
                            <field name="contact_center_state" readonly="1" />
                        </group>
                        <group>
                            <field
                                name="contact_center_tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                                readonly="1"
                            />
                        </group>
                    </group>
                    <field name="contact_center_binding_ids" readonly="1">
                        <tree>
                            <field name="account_id" />
                            <field name="identity_id" />
                            <field name="conversation_type" />
                            <field name="conversation_ref" />
                            <field name="active" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_contact_center_channel_tree" model="ir.ui.view">
        <field name="name">mail.channel.contact.center.tree</field>
        <field name="model">mail.channel</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field
                    name="contact_center_company_id"
                    groups="base.group_multi_company"
                />
                <field name="contact_center_team_id" />
                <field name="contact_center_owner_user_id" />
                <field name="contact_center_responsible_id" />
                <field name="contact_center_state" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <record id="action_contact_center_channels" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">mail.channel</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_contact_center_channel_tree" />
        <field name="domain">[('channel_type', '=', 'contact_center')]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
