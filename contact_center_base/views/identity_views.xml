<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_contact_center_identity_tree" model="ir.ui.view">
        <field name="name">contact.center.identity.tree</field>
        <field name="model">contact.center.identity</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'merged'">
                <field name="name" />
                <field name="name_source" />
                <field name="mail_guest_id" />
                <field name="partner_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="view_contact_center_identity_form" model="ir.ui.view">
        <field name="name">contact.center.identity.form</field>
        <field name="model">contact.center.identity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" /></h1></div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1" />
                            <field
                                name="company_id"
                                readonly="1"
                                groups="base.group_multi_company"
                            />
                            <field name="mail_guest_id" readonly="1" />
                            <field name="name_source" readonly="1" />
                            <field name="observed_name" readonly="1" />
                            <field name="observed_name_at" readonly="1" />
                            <field name="observed_name_inbox_event_id" readonly="1" />
                            <field name="state" readonly="1" />
                            <field
                                name="merged_into_id"
                                readonly="1"
                                attrs="{'invisible': [('state', '!=', 'merged')]}"
                            />
                        </group>
                        <group string="Explicit Contact Link">
                            <field name="partner_id" readonly="1" />
                            <field name="partner_linked_by_id" readonly="1" />
                            <field name="partner_linked_at" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="External Addresses">
                            <field name="alias_ids" readonly="1">
                                <tree>
                                    <field name="account_id" />
                                    <field name="namespace" />
                                    <field name="value_raw" />
                                    <field name="value_normalized" />
                                    <field name="role" />
                                    <field name="confidence" />
                                    <field name="last_seen_at" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contact_center_identities" model="ir.actions.act_window">
        <field name="name">Remote Identities</field>
        <field name="res_model">contact.center.identity</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_contact_center_identity_conflict_tree" model="ir.ui.view">
        <field name="name">contact.center.identity.conflict.tree</field>
        <field name="model">contact.center.identity.conflict</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'open'">
                <field name="create_date" />
                <field name="account_id" />
                <field name="identity_ids" widget="many2many_tags" />
                <field name="inbox_event_id" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="view_contact_center_identity_conflict_form" model="ir.ui.view">
        <field name="name">contact.center.identity.conflict.form</field>
        <field name="model">contact.center.identity.conflict</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_resolve"
                        type="object"
                        string="Mark Resolved"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'open')]}"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="account_id" />
                        <field name="identity_ids" widget="many2many_tags" />
                        <field name="inbox_event_id" />
                        <field name="resolved_by_id" readonly="1" />
                        <field name="resolved_at" readonly="1" />
                    </group>
                    <group string="Evidence"><field
                            name="address_evidence_json"
                            readonly="1"
                            nolabel="1"
                        /></group>
                    <group string="Resolution"><field
                            name="resolution_note"
                            nolabel="1"
                        /></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contact_center_identity_conflicts" model="ir.actions.act_window">
        <field name="name">Identity Conflicts</field>
        <field name="res_model">contact.center.identity.conflict</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'open')]</field>
    </record>
</odoo>
