<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_contact_center_resolution_reason_tree" model="ir.ui.view">
        <field name="name">contact.center.resolution.reason.tree</field>
        <field name="model">contact.center.resolution.reason</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not active">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="active" widget="boolean_toggle" />
            </tree>
        </field>
    </record>
    <record id="view_contact_center_resolution_reason_form" model="ir.ui.view">
        <field name="name">contact.center.resolution.reason.form</field>
        <field name="model">contact.center.resolution.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet><group>
                    <field name="name" />
                    <field name="sequence" />
                    <field name="active" />
                    <field name="company_id" groups="base.group_multi_company" />
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="action_contact_center_resolution_reasons" model="ir.actions.act_window">
        <field name="name">Resolution Reasons</field>
        <field name="res_model">contact.center.resolution.reason</field>
        <field name="view_mode">tree,form</field>
        <field name="target">new</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem
        id="menu_contact_center_resolution_reasons"
        name="Resolution Reasons"
        parent="menu_contact_center_root"
        action="action_contact_center_resolution_reasons"
        sequence="55"
        groups="contact_center_base.group_contact_center_supervisor"
    />
</odoo>
