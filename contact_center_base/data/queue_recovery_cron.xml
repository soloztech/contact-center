<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_contact_center_queue_recovery" model="ir.cron">
        <field name="name">Contact Center: recover orphaned queue jobs</field>
        <field name="model_id" ref="model_contact_center_inbox_event" />
        <field name="state">code</field>
        <field name="code">model._cron_recover_orphaned_queue_jobs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
    </record>
    <record id="ir_cron_contact_center_scheduled_message_recovery" model="ir.cron">
        <field name="name">Contact Center: recover scheduled messages</field>
        <field name="model_id" ref="model_contact_center_scheduled_message" />
        <field name="state">code</field>
        <field name="code">model._cron_recover_scheduled_messages()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
    </record>
</odoo>
