<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="queue_job_channel_contact_center_transcription"
        model="queue.job.channel"
    >
        <field name="name">transcription</field>
        <field name="parent_id" ref="queue_job_channel_contact_center" />
    </record>
    <record
        id="queue_job_function_contact_center_transcription"
        model="queue.job.function"
    >
        <field name="model_id" ref="model_contact_center_media_binding" />
        <field name="method">_job_transcribe</field>
        <field name="channel_id" ref="queue_job_channel_contact_center_transcription" />
        <field name="retry_pattern" eval="{1: 30, 2: 120, 3: 300}" />
    </record>
</odoo>
