<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_form_contact_center" model="ir.ui.view">
        <field name="name">sale.order.form.contact.center</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_contact_center_conversations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-headphones"
                    groups="contact_center_base.group_contact_center_agent"
                    attrs="{'invisible': [('contact_center_conversation_count', '=', 0)]}"
                >
                    <field
                        name="contact_center_conversation_count"
                        widget="statinfo"
                        string="Atendimentos"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
