<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_contact_center_pipeline_tree" model="ir.ui.view">
        <field name="name">contact.center.pipeline.tree</field>
        <field name="model">contact.center.pipeline</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="code" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="team_ids" widget="many2many_tags" />
                <field name="active" optional="show" />
                <button
                    name="action_archive"
                    type="object"
                    string="Archive"
                    icon="fa-archive"
                    attrs="{'invisible': [('active', '=', False)]}"
                />
                <button
                    name="action_unarchive"
                    type="object"
                    string="Restore"
                    icon="fa-undo"
                    attrs="{'invisible': [('active', '=', True)]}"
                />
            </tree>
        </field>
    </record>

    <record id="view_contact_center_pipeline_form" model="ir.ui.view">
        <field name="name">contact.center.pipeline.form</field>
        <field name="model">contact.center.pipeline</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_archive"
                        type="object"
                        string="Archive"
                        attrs="{'invisible': [('active', '=', False)]}"
                    />
                    <button
                        name="action_unarchive"
                        type="object"
                        string="Restore"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <field
                                name="code"
                                attrs="{'readonly': [('id', '!=', False)]}"
                            />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                attrs="{'readonly': [('id', '!=', False)]}"
                            />
                        </group>
                        <group>
                            <field name="team_ids" widget="many2many_tags" />
                            <field name="account_ids" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Stages" name="stages">
                            <field
                                name="stage_ids"
                                context="{'default_pipeline_id': active_id}"
                            >
                                <tree editable="bottom" default_order="sequence, id">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="code" />
                                    <field name="is_initial" readonly="1" />
                                    <field name="is_closed" />
                                    <field name="fold" />
                                    <field name="active" widget="boolean_toggle" />
                                    <button
                                        name="action_set_initial"
                                        type="object"
                                        string="Set as Initial"
                                        icon="fa-flag"
                                        attrs="{'invisible': ['|', '|', ('is_initial', '=', True), ('active', '=', False), ('is_closed', '=', True)]}"
                                    />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contact_center_pipelines" model="ir.actions.act_window">
        <field name="name">Pipelines de atendimento</field>
        <field name="res_model">contact.center.pipeline</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_contact_center_case_search" model="ir.ui.view">
        <field name="name">contact.center.case.search</field>
        <field name="model">contact.center.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="channel_id" />
                <field name="pipeline_id" />
                <field name="stage_id" />
                <field name="team_id" />
                <field name="responsible_user_id" />
                <filter
                    name="open_cases"
                    string="Open"
                    domain="[('stage_id.is_closed', '=', False)]"
                />
                <filter
                    name="closed_cases"
                    string="Closed"
                    domain="[('stage_id.is_closed', '=', True)]"
                />
                <separator />
                <filter
                    name="group_stage"
                    string="Stage"
                    context="{'group_by': 'stage_id'}"
                />
                <filter
                    name="group_pipeline"
                    string="Pipeline"
                    context="{'group_by': 'pipeline_id'}"
                />
                <filter
                    name="group_team"
                    string="Team"
                    context="{'group_by': 'team_id'}"
                />
                <filter
                    name="group_responsible"
                    string="Responsible"
                    context="{'group_by': 'responsible_user_id'}"
                />
                <searchpanel>
                    <field
                        name="pipeline_id"
                        string="Pipeline"
                        select="one"
                        enable_counters="1"
                    />
                    <field
                        name="team_id"
                        string="Team"
                        select="multi"
                        enable_counters="1"
                    />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_contact_center_case_tree" model="ir.ui.view">
        <field name="name">contact.center.case.tree</field>
        <field name="model">contact.center.case</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not active">
                <field name="priority" widget="priority" />
                <field name="name" />
                <field name="channel_id" />
                <field name="pipeline_id" />
                <field name="stage_id" />
                <field name="team_id" optional="show" />
                <field name="responsible_user_id" optional="show" />
                <field name="stage_changed_at" optional="show" />
                <field name="closed_at" optional="hide" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="is_default" invisible="1" />
                <field name="active" optional="show" />
                <button
                    name="action_archive"
                    type="object"
                    string="Archive"
                    icon="fa-archive"
                    attrs="{'invisible': ['|', ('active', '=', False), ('is_default', '=', True)]}"
                />
                <button
                    name="action_unarchive"
                    type="object"
                    string="Restore"
                    icon="fa-undo"
                    attrs="{'invisible': [('active', '=', True)]}"
                />
            </tree>
        </field>
    </record>

    <record id="view_contact_center_case_kanban" model="ir.ui.view">
        <field name="name">contact.center.case.kanban</field>
        <field name="model">contact.center.case</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="stage_id"
                quick_create="false"
                records_draggable="true"
                class="o_kanban_small_column"
            >
                <field name="name" />
                <field name="priority" />
                <field name="channel_id" />
                <field name="pipeline_id" />
                <field name="stage_id" />
                <field name="team_id" />
                <field name="responsible_user_id" />
                <field name="stage_changed_at" />
                <field name="active" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="oe_kanban_global_click o_kanban_record #{!record.active.raw_value ? 'oe_kanban_card_muted' : ''}"
                        >
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name" />
                                    </strong>
                                </div>
                                <field name="priority" widget="priority" />
                            </div>
                            <div class="text-muted mt-2">
                                <span
                                    class="fa fa-comments-o me-1"
                                    title="Conversation"
                                />
                                <field name="channel_id" />
                            </div>
                            <div class="text-muted mt-1">
                                <field name="pipeline_id" />
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="team_id" />
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field
                                        name="responsible_user_id"
                                        widget="many2one_avatar_user"
                                    />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_contact_center_case_form" model="ir.ui.view">
        <field name="name">contact.center.case.form</field>
        <field name="model">contact.center.case</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_archive"
                        type="object"
                        string="Archive"
                        attrs="{'invisible': ['|', ('active', '=', False), ('is_default', '=', True)]}"
                    />
                    <button
                        name="action_unarchive"
                        type="object"
                        string="Restore"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'clickable': '1'}"
                        domain="[('pipeline_id', '=', pipeline_id)]"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <field name="id" invisible="1" />
                    <field name="active" invisible="1" />
                    <field name="is_default" invisible="1" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="channel_id"
                                domain="[('channel_type', '=', 'contact_center')]"
                                attrs="{'readonly': [('id', '!=', False)]}"
                            />
                            <field
                                name="company_id"
                                attrs="{'readonly': [('id', '!=', False)]}"
                            />
                            <field
                                name="pipeline_id"
                                domain="[('company_id', '=', company_id), ('active', '=', True)]"
                                attrs="{'readonly': [('id', '!=', False)]}"
                            />
                            <field
                                name="team_id"
                                domain="[('company_id', '=', company_id)]"
                                readonly="1"
                            />
                        </group>
                        <group>
                            <field name="responsible_user_id" />
                            <field name="priority" widget="priority" />
                            <field name="opened_at" readonly="1" />
                            <field name="stage_changed_at" readonly="1" />
                            <field name="closed_at" readonly="1" />
                            <field name="stage_revision" readonly="1" />
                            <field name="case_ref" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field
                                name="description"
                                placeholder="Descreva este atendimento..."
                            />
                        </page>
                        <page string="Stage History" name="stage_history">
                            <field name="transition_ids" readonly="1">
                                <tree create="false" edit="false" delete="false">
                                    <field name="occurred_at" />
                                    <field name="from_stage_id" />
                                    <field name="to_stage_id" />
                                    <field name="changed_by_id" />
                                    <field name="source" />
                                    <field name="from_revision" />
                                    <field name="to_revision" />
                                    <field name="is_noop" optional="hide" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="action_contact_center_cases" model="ir.actions.act_window">
        <field name="name">Atendimentos</field>
        <field name="res_model">contact.center.case</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_contact_center_case_search" />
        <field name="context">{'search_default_group_stage': 1}</field>
    </record>

    <record id="view_contact_center_team_form_pipeline" model="ir.ui.view">
        <field name="name">contact.center.team.form.pipeline</field>
        <field name="model">contact.center.team</field>
        <field
            name="inherit_id"
            ref="contact_center_base.view_contact_center_team_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Pipelines" name="pipelines">
                    <group>
                        <field name="default_pipeline_id" />
                        <field name="pipeline_ids" widget="many2many_tags" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_contact_center_account_form_pipeline" model="ir.ui.view">
        <field name="name">contact.center.account.form.pipeline</field>
        <field name="model">contact.center.account</field>
        <field
            name="inherit_id"
            ref="contact_center_base.view_contact_center_account_form"
        />
        <field name="arch" type="xml">
            <field name="access_team_ids" position="after">
                <field name="default_pipeline_id" />
            </field>
        </field>
    </record>

    <record id="view_mail_channel_form_contact_center_cases" model="ir.ui.view">
        <field name="name">mail.channel.form.contact.center.cases</field>
        <field name="model">mail.channel</field>
        <field
            name="inherit_id"
            ref="contact_center_base.view_mail_channel_form_contact_center"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_center']/group" position="before">
                <button
                    name="action_contact_center_cases"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-briefcase"
                >
                    <field
                        name="contact_center_case_count"
                        widget="statinfo"
                        string="Atendimentos"
                    />
                </button>
            </xpath>
            <field name="contact_center_binding_ids" position="after">
                <field name="contact_center_case_ids" readonly="1">
                    <tree create="false" edit="false" delete="false">
                        <field name="name" />
                        <field name="pipeline_id" />
                        <field name="stage_id" />
                        <field name="responsible_user_id" />
                        <field name="active" />
                    </tree>
                </field>
            </field>
        </field>
    </record>

    <menuitem
        id="menu_contact_center_cases"
        name="Atendimentos"
        parent="contact_center_base.menu_contact_center_root"
        action="action_contact_center_cases"
        sequence="15"
        groups="contact_center_base.group_contact_center_agent"
    />
    <menuitem
        id="menu_contact_center_pipelines"
        name="Pipelines de atendimento"
        parent="contact_center_base.menu_contact_center_configuration"
        action="action_contact_center_pipelines"
        sequence="35"
        groups="contact_center_base.group_contact_center_admin"
    />
</odoo>
