<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_contact_center_followup_request_tree" model="ir.ui.view">
        <field name="name">contact.center.followup.request.tree</field>
        <field name="model">contact.center.followup.request</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="create_date" />
                <field name="channel_id" />
                <field name="case_id" />
                <field name="activity_record_id" />
                <field name="requested_by_id" />
                <field name="state" />
                <field name="completed_by_id" optional="show" />
                <field name="completed_at" optional="show" />
                <field name="ui_request_id" optional="hide" />
                <field name="completion_request_id" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="view_contact_center_followup_request_form" model="ir.ui.view">
        <field name="name">contact.center.followup.request.form</field>
        <field name="model">contact.center.followup.request</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="channel_id" />
                            <field name="case_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="requested_by_id" />
                        </group>
                        <group>
                            <field name="activity_id" />
                            <field name="activity_record_id" />
                            <field name="state" />
                            <field name="completed_by_id" />
                            <field name="completed_at" />
                            <field name="closed_at" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <group>
                                <field name="ui_request_id" />
                                <field name="schedule_payload_sha256" />
                            </group>
                            <field
                                name="activity_snapshot_json"
                                nolabel="1"
                                widget="contact_center_json_viewer"
                            />
                        </page>
                        <page string="Completion">
                            <group>
                                <field name="completion_request_id" />
                                <field name="completion_payload_sha256" />
                            </group>
                            <field
                                name="completion_snapshot_json"
                                nolabel="1"
                                widget="contact_center_json_viewer"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contact_center_followup_requests" model="ir.actions.act_window">
        <field name="name">Follow-up Receipts</field>
        <field name="res_model">contact.center.followup.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_contact_center_followup_requests"
        name="Follow-up Receipts"
        parent="contact_center_base.menu_contact_center_technical_records"
        action="action_contact_center_followup_requests"
        sequence="70"
        groups="base.group_system"
    />
</odoo>
