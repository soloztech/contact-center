<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="contact_center_ui.ContactCenterSystray" owl="1">
        <Dropdown
            t-if="state.enabled"
            class="'o_contact_center_systray'"
            position="'bottom-end'"
            title="'Contact Center'"
        >
            <t t-set-slot="toggler">
                <i class="fa fa-headphones" role="img" aria-label="Contact Center" />
                <span
                    t-if="state.mine"
                    class="o_contact_center_systray_counter badge rounded-pill bg-success"
                    t-esc="state.mine"
                />
            </t>
            <DropdownItem
                class="'o_contact_center_systray_mine'"
                onSelected="() => this.open('mine_unread')"
            >Minhas não lidas (<t t-esc="state.mine" />)</DropdownItem>
            <DropdownItem
                class="'o_contact_center_systray_all'"
                onSelected="() => this.open('all_unread')"
            >Todas as não lidas (<t t-esc="state.all" />)</DropdownItem>
            <DropdownItem
                class="'o_contact_center_systray_open'"
                onSelected="() => this.open(false)"
            >Abrir Central</DropdownItem>
        </Dropdown>
    </t>
</templates>
