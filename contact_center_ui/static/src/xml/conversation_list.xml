<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="contact_center_ui.ConversationList" owl="1">
        <aside class="cc-inbox-panel" aria-label="Conversas">
            <header class="cc-inbox-header">
                <div class="cc-inbox-title">
                    <h1>Conversas</h1>
                    <span t-esc="displayedCount" />
                </div>
                <div class="cc-inbox-header__status">
                    <button
                        t-if="state.attention &amp;&amp; state.attention.available"
                        type="button"
                        t-attf-class="cc-attention-beacon cc-attention-beacon--#{attentionMeta.state}"
                        t-att-title="attentionMeta.label"
                        t-att-aria-label="attentionMeta.label"
                        t-on-click="enableAttention"
                    >
                        <i t-att-class="attentionMeta.icon" aria-hidden="true" />
                        <b
                            t-if="state.attention.unseen"
                            t-esc="state.attention.unseen"
                            aria-hidden="true"
                        />
                    </button>
                    <span
                        class="sr-only"
                        role="status"
                        t-att-title="realtimeMeta.description"
                        t-att-aria-label="realtimeMeta.description"
                    >
                        <span t-esc="realtimeMeta.label" />
                    </span>
                    <ConnectionHealth
                        t-if="store.hasConnectionHealth"
                        store="store"
                        state="state"
                    />
                    <button
                        type="button"
                        class="cc-icon-button cc-inbox-density-toggle"
                        t-att-title="densityButtonLabel"
                        t-att-aria-label="densityButtonLabel"
                        t-att-aria-pressed="compactMode ? 'true' : 'false'"
                        t-on-click="toggleDensity"
                    >
                        <i
                            t-attf-class="fa #{compactMode ? 'fa-angle-double-right' : 'fa-angle-double-left'}"
                            aria-hidden="true"
                        />
                    </button>
                </div>
            </header>

            <div id="cc-inbox-tools" class="cc-inbox-tools">
                <div class="cc-inbox-search-row">
                <label class="cc-search-field">
                    <i class="fa fa-search" aria-hidden="true" />
                    <span class="sr-only">Buscar conversas</span>
                    <input
                            t-ref="search"
                            type="search"
                            placeholder="Nome, contato ou número"
                            t-att-value="state.filters.query"
                            t-on-input="onSearchInput"
                        />
                </label>
                <button
                        t-if="startAccounts.length"
                        t-ref="startToggle"
                        type="button"
                        class="cc-start-conversation-toggle"
                        aria-label="Iniciar conversa"
                        title="Iniciar conversa"
                        aria-haspopup="dialog"
                        aria-controls="cc-start-conversation-panel"
                        t-att-aria-expanded="ui.startOpen ? 'true' : 'false'"
                        t-on-click="toggleStartConversation"
                    ><i class="fa fa-commenting-o" aria-hidden="true" /><i
                            class="fa fa-plus"
                            aria-hidden="true"
                        /></button>
                </div>

                <div class="cc-inbox-filter-toolbar">
                    <button
                        type="button"
                        t-ref="filterToggle"
                        t-attf-class="cc-inbox-filter-toggle #{activeFilterCount ? 'has-filters' : ''}"
                        t-att-aria-expanded="ui.filtersOpen ? 'true' : 'false'"
                        aria-controls="cc-inbox-filter-panel"
                        aria-haspopup="dialog"
                        t-on-click="toggleFilters"
                    >
                        <i class="fa fa-filter" aria-hidden="true" />
                        <span>Filtros</span>
                        <b t-if="activeFilterCount" t-esc="activeFilterCount" />
                    </button>
                    <span
                        class="cc-inbox-filter-summary"
                        t-att-title="filterSummary"
                        t-esc="filterSummary"
                    />
                    <div
                        class="cc-list-view-switch"
                        role="group"
                        aria-label="Visualização"
                    >
                        <button
                            type="button"
                            t-att-class="ui.view === 'grouped' ? 'is-active' : ''"
                            t-att-aria-pressed="ui.view === 'grouped' ? 'true' : 'false'"
                            aria-label="Agrupar por caixa"
                            title="Agrupar por caixa"
                            t-on-click="() => this.setView('grouped')"
                        ><i class="fa fa-sitemap" aria-hidden="true" /></button>
                        <button
                            type="button"
                            t-att-class="ui.view === 'flat' ? 'is-active' : ''"
                            t-att-aria-pressed="ui.view === 'flat' ? 'true' : 'false'"
                            aria-label="Lista sem agrupamento"
                            title="Lista sem agrupamento"
                            t-on-click="() => this.setView('flat')"
                        ><i class="fa fa-list-ul" aria-hidden="true" /></button>
                    </div>
                </div>

                <section
                    t-if="ui.filtersOpen"
                    t-ref="filterPanel"
                    id="cc-inbox-filter-panel"
                    class="cc-inbox-filter-panel"
                    role="dialog"
                    aria-label="Filtrar conversas"
                    tabindex="-1"
                >
                    <header class="cc-inbox-filter-panel__header">
                        <h2>Filtrar conversas</h2>
                        <button
                            type="button"
                            class="cc-icon-button"
                            aria-label="Fechar filtros"
                            t-on-click="() => this.closeFilters()"
                        ><i class="fa fa-times" aria-hidden="true" /></button>
                    </header>
                    <div class="cc-inbox-filter-panel__body">
                    <fieldset class="cc-inbox-filter-section">
                        <legend><i
                                    class="fa fa-circle-o"
                                    aria-hidden="true"
                                />Estado</legend>
                        <div
                                class="cc-inbox-tabs"
                                role="group"
                                aria-label="Filtrar por estado"
                            >
                            <button
                                    t-foreach="store.conversationStates"
                                    t-as="item"
                                    t-key="item.key"
                                    type="button"
                                    t-attf-class="cc-state-option cc-state-option--#{item.key} #{state.filters.states.includes(item.key) ? 'is-active' : ''}"
                                    t-att-aria-pressed="state.filters.states.includes(item.key) ? 'true' : 'false'"
                                    t-on-click="() => this.onStateClick(item.key)"
                                >
                                <i
                                        t-attf-class="fa #{state.filters.states.includes(item.key) ? 'fa-check-square' : 'fa-square-o'}"
                                        aria-hidden="true"
                                    />
                                <span t-esc="item.label" />
                            </button>
                        </div>
                        <p
                                class="cc-inbox-filter-hint"
                            >Combine estados. Nenhum marcado mostra todos.</p>
                    </fieldset>

                    <fieldset class="cc-inbox-filter-section">
                        <legend><i
                                    class="fa fa-user-o"
                                    aria-hidden="true"
                                />Responsável</legend>
                    <div
                                class="cc-responsibility-tabs"
                                role="group"
                                aria-label="Filtrar por responsável"
                            >
                        <button
                                    type="button"
                                    t-att-class="state.filters.responsibility === 'all' &amp;&amp; !state.filters.responsibleId ? 'is-active' : ''"
                                    t-att-aria-pressed="state.filters.responsibility === 'all' &amp;&amp; !state.filters.responsibleId ? 'true' : 'false'"
                                    t-on-click="() => this.setResponsibility('all')"
                                >Todas</button>
                        <button
                                    type="button"
                                    t-att-class="state.filters.responsibility === 'mine' ? 'is-active' : ''"
                                    t-att-aria-pressed="state.filters.responsibility === 'mine' ? 'true' : 'false'"
                                    t-on-click="() => this.setResponsibility('mine')"
                                >Minhas</button>
                        <button
                                    type="button"
                                    t-att-class="state.filters.responsibility === 'unassigned' ? 'is-active' : ''"
                                    t-att-aria-pressed="state.filters.responsibility === 'unassigned' ? 'true' : 'false'"
                                    t-on-click="() => this.setResponsibility('unassigned')"
                                >Não atribuídas</button>
                    </div>
                    <label class="cc-responsible-filter">
                        <span class="sr-only">Selecionar responsável</span>
                        <select
                                    aria-label="Selecionar responsável"
                                    t-on-change="onResponsibleChange"
                                >
                            <option
                                        value=""
                                        t-att-selected="!state.filters.responsibleId"
                                    >Selecionar responsável...</option>
                            <option
                                        t-foreach="store.agents"
                                        t-as="agent"
                                        t-key="agent.id"
                                        t-att-value="agent.id"
                                        t-att-selected="state.filters.responsibleId === agent.id"
                                    ><t t-esc="agent.name" /></option>
                        </select>
                    </label>
                    </fieldset>

                    <fieldset class="cc-inbox-filter-section">
                        <legend><i
                                    class="fa fa-comments-o"
                                    aria-hidden="true"
                                />Conversa</legend>
                <div class="cc-secondary-filters">
                    <button
                                    type="button"
                                    t-att-class="state.filters.unreadOnly ? 'cc-filter-chip is-active' : 'cc-filter-chip'"
                                    t-att-aria-pressed="state.filters.unreadOnly ? 'true' : 'false'"
                                    t-on-click="toggleUnreadOnly"
                                >
                        <i class="fa fa-envelope" aria-hidden="true" />
                        <span>Não lidas</span>
                    </button>
                    <div
                                    class="cc-conversation-type-filter"
                                    role="group"
                                    aria-label="Tipo de conversa"
                                >
                        <button
                                        type="button"
                                        t-att-class="!state.filters.conversationType ? 'is-active' : ''"
                                        t-att-aria-pressed="!state.filters.conversationType ? 'true' : 'false'"
                                        t-on-click="() => this.setConversationType(false)"
                                    >Todas</button>
                        <button
                                        type="button"
                                        t-att-class="state.filters.conversationType === 'direct' ? 'is-active' : ''"
                                        t-att-aria-pressed="state.filters.conversationType === 'direct' ? 'true' : 'false'"
                                        t-on-click="() => this.setConversationType('direct')"
                                    >Diretas</button>
                        <button
                                        type="button"
                                        t-att-class="state.filters.conversationType === 'group' ? 'is-active' : ''"
                                        t-att-aria-pressed="state.filters.conversationType === 'group' ? 'true' : 'false'"
                                        t-on-click="() => this.setConversationType('group')"
                                    >Grupos</button>
                    </div>
                </div>
                    </fieldset>
                    <fieldset
                            t-if="accounts.length > 1"
                            class="cc-inbox-filter-section"
                        >
                        <legend><i
                                    class="fa fa-inbox"
                                    aria-hidden="true"
                                />Caixa</legend>
                        <label class="cc-account-filter">
                            <span class="sr-only">Filtrar por caixa</span>
                            <select
                                    t-on-change="onAccountChange"
                                    aria-label="Filtrar por caixa"
                                >
                                <option value="">Todas as caixas</option>
                                <option
                                        t-foreach="accounts"
                                        t-as="account"
                                        t-key="account.id"
                                        t-att-value="account.id"
                                        t-att-selected="state.filters.accountId === account.id"
                                    ><t t-esc="account.name" /></option>
                            </select>
                        </label>
                    </fieldset>
                    <fieldset class="cc-inbox-filter-section">
                        <legend><i
                                    class="fa fa-tag"
                                    aria-hidden="true"
                                />Marcadores</legend>
                    <div
                                class="cc-tag-filter-options"
                                role="group"
                                aria-label="Filtrar por marcadores"
                            >
                        <label
                                    t-foreach="store.tags"
                                    t-as="tag"
                                    t-key="tag.id"
                                    class="cc-tag-filter-option"
                                >
                            <input
                                        type="checkbox"
                                        t-att-checked="selectedFilterTagIds.includes(tag.id)"
                                        t-on-change="() => this.toggleFilterTag(tag.id)"
                                    />
                            <span t-esc="tag.name" />
                        </label>
                    </div>
                    <p
                                t-if="store.tags.length"
                                class="cc-inbox-filter-hint"
                            >Mostra conversas com qualquer marcador selecionado.</p>
                    <p
                                t-else=""
                                class="cc-inbox-filter-hint"
                            >Nenhum marcador cadastrado. Peça ao supervisor para cadastrar.</p>
                    </fieldset>
                    <fieldset
                            t-if="store.capabilities.followups === true"
                            class="cc-inbox-filter-section"
                        >
                        <legend><i
                                    class="fa fa-clock-o"
                                    aria-hidden="true"
                                />Meus follow-ups</legend>
                    <label class="cc-activity-filter">
                        <span class="sr-only">Filtrar pelos meus follow-ups</span>
                        <i class="fa fa-clock-o" aria-hidden="true" />
                        <select
                                    aria-label="Filtrar pelos meus follow-ups"
                                    t-on-change="onActivityTimingChange"
                                >
                            <option value="">Follow-up: sem filtro</option>
                            <option
                                        value="all"
                                        t-att-selected="state.filters.activityTiming === 'all'"
                                    >Todos os meus follow-ups</option>
                            <option
                                        value="due"
                                        t-att-selected="state.filters.activityTiming === 'due'"
                                    >Meus de hoje e atrasados</option>
                            <option
                                        value="overdue"
                                        t-att-selected="state.filters.activityTiming === 'overdue'"
                                    >Meus atrasados</option>
                            <option
                                        value="today"
                                        t-att-selected="state.filters.activityTiming === 'today'"
                                    >Meus de hoje</option>
                            <option
                                        value="planned"
                                        t-att-selected="state.filters.activityTiming === 'planned'"
                                    >Meus próximos</option>
                        </select>
                    </label>
                    </fieldset>
                    </div>
                    <footer class="cc-inbox-filter-panel__footer">
                        <button
                            type="button"
                            class="cc-inbox-filter-clear"
                            t-on-click="clearFilters"
                        >Limpar filtros</button>
                        <button
                            type="button"
                            class="cc-inbox-filter-done"
                            t-on-click="() => this.closeFilters()"
                        >Concluir</button>
                    </footer>
                </section>

                <form
                    t-if="ui.startOpen"
                    t-ref="startPanel"
                    id="cc-start-conversation-panel"
                    class="cc-inbox-filter-panel cc-start-conversation-panel"
                    role="dialog"
                    aria-labelledby="cc-start-conversation-title"
                    t-on-submit="submitStartConversation"
                >
                    <header class="cc-inbox-filter-panel__header">
                        <h2 id="cc-start-conversation-title">Iniciar conversa</h2>
                        <button
                            type="button"
                            class="cc-icon-button"
                            aria-label="Fechar iniciar conversa"
                            t-on-click="() => this.closeStartConversation()"
                        ><i class="fa fa-times" aria-hidden="true" /></button>
                    </header>
                    <div class="cc-inbox-filter-panel__body">
                        <label class="cc-start-field">
                            <span>Caixa de saída</span>
                            <select
                                t-ref="startAccount"
                                t-att-disabled="ui.startPending"
                                t-on-change="onStartAccountChange"
                                required="required"
                            >
                                <option
                                    value=""
                                    t-att-selected="!ui.startAccountId"
                                >Selecione a caixa</option>
                                <option
                                    t-foreach="startAccounts"
                                    t-as="account"
                                    t-key="account.id"
                                    t-att-value="account.id"
                                    t-att-selected="ui.startAccountId === account.id"
                                ><t t-esc="account.name" /></option>
                            </select>
                        </label>
                        <label class="cc-start-field">
                            <span>Número do WhatsApp</span>
                            <input
                                t-ref="startPhone"
                                type="tel"
                                inputmode="tel"
                                autocomplete="tel"
                                maxlength="64"
                                placeholder="DDD + número"
                                t-att-value="ui.startPhone"
                                t-att-disabled="ui.startPending"
                                t-att-aria-invalid="ui.startError ? 'true' : 'false'"
                                aria-describedby="cc-start-phone-hint cc-start-phone-result"
                                t-on-input="onStartPhoneInput"
                                t-on-blur="previewStartPhone"
                                required="required"
                            />
                        </label>
                        <p
                            id="cc-start-phone-hint"
                            class="cc-inbox-filter-hint"
                            t-esc="startPhoneHint"
                        />
                        <div
                            id="cc-start-phone-result"
                            class="cc-start-phone-result"
                            aria-live="polite"
                        >
                            <span t-if="ui.startPreviewPending"><i
                                    class="fa fa-spinner fa-spin"
                                    aria-hidden="true"
                                /> Conferindo formato...</span>
                            <span
                                t-elif="ui.startPreview"
                                class="cc-start-phone-preview"
                            ><i
                                    class="fa fa-check"
                                    aria-hidden="true"
                                /> Número: <strong
                                    t-esc="ui.startPreview.formatted_phone"
                                /></span>
                        </div>
                        <p
                            t-if="ui.startError"
                            class="cc-start-error"
                            role="alert"
                            t-esc="ui.startError"
                        />
                        <p
                            class="cc-inbox-filter-hint"
                        >Uma conversa existente será reutilizada. Os filtros serão ajustados para mostrar a caixa selecionada. Nenhuma mensagem será enviada ao abrir.</p>
                    </div>
                    <footer class="cc-inbox-filter-panel__footer">
                        <button
                            type="button"
                            class="cc-inbox-filter-clear"
                            t-on-click="() => this.closeStartConversation()"
                        >Cancelar</button>
                        <button
                            type="submit"
                            class="cc-inbox-filter-done"
                            t-att-disabled="!canSubmitStart"
                        >
                            <t t-if="ui.startPending"><i
                                    class="fa fa-spinner fa-spin"
                                    aria-hidden="true"
                                /> Abrindo...</t>
                            <t t-else="">Abrir conversa</t>
                        </button>
                    </footer>
                </form>
            </div>

            <div
                class="cc-conversation-list"
                t-ref="viewport"
                t-on-scroll="onListScroll"
            >
                <div
                    t-if="state.listPhase === 'loading'"
                    class="cc-list-skeleton"
                    aria-busy="true"
                >
                    <span t-foreach="[1, 2, 3, 4, 5]" t-as="line" t-key="line" />
                </div>
                <div
                    t-elif="state.listPhase === 'error'"
                    class="cc-list-state"
                    role="alert"
                >
                    <strong>Não foi possível carregar as conversas.</strong>
                    <button
                        type="button"
                        t-on-click="() => store.loadConversations({reset: true})"
                    >Tentar novamente</button>
                </div>
                <div
                    t-elif="ui.view === 'flat' &amp;&amp; !state.conversations.length"
                    class="cc-list-state"
                >
                    <span class="cc-list-state__icon"><i
                            class="fa fa-check"
                            aria-hidden="true"
                        /></span>
                    <strong>Nenhuma conversa neste filtro.</strong>
                    <p>Altere o estado ou a busca para ver outros atendimentos.</p>
                </div>
                <div
                    t-elif="ui.view === 'flat' &amp;&amp; !filteredConversations.length"
                    class="cc-list-state"
                >
                    <span class="cc-list-state__icon"><i
                            class="fa fa-filter"
                            aria-hidden="true"
                        /></span>
                    <strong>Nenhuma conversa neste recorte.</strong>
                    <p>Escolha outro responsável ou altere os filtros acima.</p>
                </div>
                <t t-elif="ui.view === 'grouped' &amp;&amp; conversationGroups.length">
                    <section
                        t-foreach="conversationGroups"
                        t-as="group"
                        t-key="group.key"
                        t-attf-class="cc-inbox-group #{inboxCollapsed(group.key) ? 'is-collapsed' : ''}"
                    >
                        <button
                            type="button"
                            class="cc-inbox-group__header"
                            t-att-aria-expanded="inboxCollapsed(group.key) ? 'false' : 'true'"
                            t-att-aria-controls="inboxPanelId(group)"
                            t-att-title="inboxCountLabel(group)"
                            t-on-click="() => this.toggleInbox(group.key)"
                        >
                            <span class="cc-inbox-group__chevron" aria-hidden="true">
                                <i
                                    t-attf-class="fa #{inboxCollapsed(group.key) ? 'fa-angle-right' : 'fa-angle-down'}"
                                />
                            </span>
                            <span class="cc-inbox-group__glyph" aria-hidden="true">
                                <i class="fa fa-inbox" />
                            </span>
                            <span class="cc-inbox-group__identity">
                                <strong t-esc="group.name" />
                                <small
                                    t-esc="group.platform || 'Conta de atendimento'"
                                />
                            </span>
                            <span class="cc-inbox-group__metrics">
                                <b
                                    t-if="group.unread_count"
                                    t-att-aria-label="inboxUnreadLabel(group)"
                                    t-esc="group.unread_count"
                                />
                                <span
                                    t-att-aria-label="inboxCountLabel(group)"
                                    t-esc="group.conversations.length"
                                />
                            </span>
                        </button>
                        <div
                            t-att-id="inboxPanelId(group)"
                            t-att-hidden="inboxCollapsed(group.key) ? true : false"
                            class="cc-inbox-group__conversations"
                        >
                            <div
                                t-if="!group.conversations.length"
                                class="cc-inbox-group__empty"
                            >Nenhuma conversa neste filtro.</div>
                            <t
                                t-foreach="group.conversations"
                                t-as="conversation"
                                t-key="conversation.channel_id"
                            >
                                <t t-call="contact_center_ui.ConversationListItem" />
                            </t>
                        </div>
                    </section>
                </t>
                <div t-elif="ui.view === 'grouped'" class="cc-list-state">
                    <span class="cc-list-state__icon"><i
                            class="fa fa-check"
                            aria-hidden="true"
                        /></span>
                    <strong>Nenhuma caixa disponível.</strong>
                    <p>Solicite acesso a uma equipe de atendimento.</p>
                </div>
                <t t-else="">
                    <t
                        t-foreach="filteredConversations"
                        t-as="conversation"
                        t-key="conversation.channel_id"
                    >
                        <t t-call="contact_center_ui.ConversationListItem" />
                    </t>
                </t>
                <button
                    t-if="state.listPhase !== 'loading' &amp;&amp; state.listPhase !== 'error' &amp;&amp; state.conversationsHaveMore"
                    type="button"
                    class="cc-load-more"
                    t-att-disabled="state.listPhase === 'loading_more'"
                    t-on-click="loadMore"
                >
                    <t t-if="state.listPhase === 'loading_more'">Carregando…</t>
                    <t
                        t-elif="state.filters.responsibility !== 'all'"
                    >Carregar mais neste recorte</t>
                    <t t-else="">Carregar mais</t>
                </button>
            </div>
        </aside>
    </t>

    <t t-name="contact_center_ui.ConversationListItem" owl="1">
        <div
            t-att-class="itemClass(conversation)"
            t-att-data-channel-id="conversation.channel_id"
        >
            <button
                type="button"
                class="cc-conversation-item__open"
                t-att-aria-current="conversation.channel_id === state.selectedChannelId ? 'true' : false"
                t-on-click="() => this.select(conversation)"
            >
            <span class="cc-conversation-item__trace" aria-hidden="true" />
            <DeferredImage
                    t-if="avatarUrl(conversation)"
                    className="'cc-avatar cc-avatar--image'"
                    src="avatarUrl(conversation)"
                    alt="''"
                    ariaHidden="true"
                    priority="10"
                />
            <span
                    t-else=""
                    class="cc-avatar"
                    t-esc="initials(displayName(conversation))"
                />
            <span class="cc-conversation-item__body">
                <span class="cc-conversation-item__line">
                    <strong t-esc="displayName(conversation)" />
                    <span class="cc-conversation-item__signals">
                        <i
                                t-if="conversation.ignored === true"
                                class="fa fa-ban"
                                title="Novas mensagens ignoradas nesta caixa"
                                aria-label="Conversa ignorada nesta caixa"
                            />
                        <i
                                t-if="preference(conversation).pinned"
                                class="fa fa-thumb-tack"
                                title="Conversa fixada"
                                aria-label="Conversa fixada"
                            />
                        <i
                                t-if="preference(conversation).muted"
                                class="fa fa-bell-slash"
                                title="Conversa silenciada"
                                aria-label="Conversa silenciada"
                            />
                        <time t-esc="relativeDate(conversation.last_activity_at)" />
                    </span>
                </span>
                <span class="cc-conversation-item__line cc-conversation-item__preview">
                    <span>
                        <i
                                t-if="deliveryIcon(conversation)"
                                t-att-class="deliveryClass(conversation)"
                                t-att-title="deliveryLabel(conversation)"
                                t-esc="deliveryIcon(conversation)"
                            />
                        <t t-if="conversation.last_message">
                            <span t-esc="preview(conversation)" />
                        </t>
                        <span t-else="">Conversa iniciada</span>
                    </span>
                    <b
                            t-if="conversation.unread_count"
                            t-esc="conversation.unread_count"
                        />
                </span>
                <span class="cc-conversation-item__meta">
                    <small
                            class="cc-inbox-badge"
                            t-att-title="inboxMetadata(conversation).name"
                        >
                        <i class="fa fa-inbox" aria-hidden="true" />
                        <span t-esc="inboxMetadata(conversation).name" />
                    </small>
                    <small
                            t-if="isGroup(conversation)"
                            class="cc-kind-badge"
                            t-esc="groupBadgeLabel(conversation)"
                        />
                    <small
                            t-if="conversation.responsible"
                            class="cc-responsible-badge"
                            t-esc="conversation.responsible.name"
                        />
                    <small
                            t-else=""
                            class="cc-responsible-badge"
                        >Sem responsável</small>
                </span>
            </span>
            </button>
            <ConversationMenu
                conversation="conversation"
                busy="!!ui.pendingConversationIds[conversation.channel_id]"
                onAction.bind="runConversationAction"
            />
        </div>
    </t>
    <t t-name="contact_center_ui.ConversationMenu" owl="1">
            <Dropdown
            class="'cc-conversation-item__menu'"
            togglerClass="'cc-conversation-item__menu-toggle'"
            menuClass="'cc-conversation-menu'"
            position="'bottom-end'"
            title="label"
            showCaret="false"
        >
                <t t-set-slot="toggler">
                    <i class="fa fa-chevron-down" aria-hidden="true" />
                    <span class="sr-only" t-esc="label" />
                </t>
                <span
                t-if="props.busy"
                class="dropdown-item text-muted"
                role="status"
            >Atualizando conversa…</span>
                <t t-else="">
                    <DropdownItem onSelected="() => this.selectAction('archived')">
                        <i class="fa fa-archive" aria-hidden="true" />
                        <t
                        t-if="props.conversation.state === 'archived'"
                    >Desarquivar conversa</t>
                        <t t-else="">Arquivar conversa</t>
                    </DropdownItem>
                    <DropdownItem onSelected="() => this.selectAction('muted')">
                        <i class="fa fa-bell-slash" aria-hidden="true" />
                        <t t-if="preference.muted">Ativar notificações</t>
                        <t t-else="">Silenciar conversa</t>
                    </DropdownItem>
                    <DropdownItem onSelected="() => this.selectAction('pinned')">
                        <i class="fa fa-thumb-tack" aria-hidden="true" />
                        <t t-if="preference.pinned">Desafixar conversa</t>
                        <t t-else="">Fixar conversa</t>
                    </DropdownItem>
                    <DropdownItem onSelected="() => this.selectAction('unread')">
                        <i class="fa fa-envelope" aria-hidden="true" />
                        Marcar como não lida
                    </DropdownItem>
                    <DropdownItem
                    t-if="can('ignore_conversation')"
                    onSelected="() => this.selectAction('ignored')"
                >
                        <i class="fa fa-ban" aria-hidden="true" />
                        <t t-esc="ignoreLabel" />
                    </DropdownItem>
                    <DropdownItem
                    t-if="can('delete_conversation')"
                    onSelected="() => this.selectAction('delete')"
                >
                        <span class="text-danger">
                            <i class="fa fa-trash" aria-hidden="true" />
                            Excluir conversa
                        </span>
                    </DropdownItem>
                </t>
            </Dropdown>
    </t>
</templates>
