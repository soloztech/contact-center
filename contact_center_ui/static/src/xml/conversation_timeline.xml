<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="contact_center_ui.ConversationTimeline" owl="1">
        <div class="cc-timeline-shell">
            <section
                class="cc-timeline"
                t-ref="viewport"
                t-on-click="closeActions"
                t-on-scroll="onViewportScroll"
            >
                <div class="cc-timeline__inner">
                <button
                        t-if="state.timelineHasMore"
                        type="button"
                        class="cc-load-older"
                        t-att-disabled="state.timelinePhase === 'loading_more'"
                        t-on-click="loadOlder"
                    >
                    <t
                            t-if="state.timelinePhase === 'loading_more'"
                        >Carregando histórico…</t>
                    <t t-else="">Ver mensagens anteriores</t>
                </button>

                <div
                        t-if="state.timelinePhase === 'loading'"
                        class="cc-timeline-state"
                        aria-busy="true"
                    >
                    <span class="cc-message-skeleton cc-message-skeleton--left" />
                    <span class="cc-message-skeleton cc-message-skeleton--right" />
                    <span
                            class="cc-message-skeleton cc-message-skeleton--left is-short"
                        />
                </div>
                <div
                        t-elif="state.timelinePhase === 'error'"
                        class="cc-timeline-state"
                        role="alert"
                    >
                    <strong>As mensagens não foram carregadas.</strong>
                    <button
                            type="button"
                            t-on-click="() => store.loadTimeline({reset: true})"
                        >Tentar novamente</button>
                </div>
                <div t-elif="!state.messages.length" class="cc-timeline-empty">
                    <span aria-hidden="true">···</span>
                    <strong>A conversa ainda não possui mensagens.</strong>
                </div>
                <t t-else="">
                    <t
                            t-foreach="state.messages"
                            t-as="message"
                            t-key="message.message_id"
                        >
                        <div
                                t-if="startsDay(message, message_index)"
                                class="cc-day-divider"
                            >
                            <span t-esc="dayLabel(message.date)" />
                        </div>
                        <div
                                t-if="state.timelineFirstUnreadMessageId === message.message_id"
                                class="cc-unread-divider"
                                t-att-data-unread-boundary="message.message_id"
                                role="separator"
                                aria-label="Mensagens não lidas"
                            >
                            <span>Mensagens não lidas</span>
                        </div>
                        <article
                                t-if="isControlMessage(message)"
                                t-att-class="messageClass(message, message_index)"
                                t-att-data-message-id="message.message_id"
                                role="note"
                                t-att-aria-label="controlAriaLabel(message)"
                            >
                            <div class="cc-message__content">
                                <div class="cc-message__lane">
                                    <div class="cc-message__stack">
                                        <div class="cc-message__bubble">
                                            <MessageContent message="message" />
                                            <footer>
                                                <time t-esc="time(message.date)" />
                                            </footer>
                                        </div>
                                    </div>
                                    <t
                                            t-call="contact_center_ui.TimelineMessageActions"
                                        />
                                </div>
                            </div>
                        </article>
                        <article
                                t-else=""
                                t-att-class="messageClass(message, message_index)"
                                t-att-data-message-id="message.message_id"
                            >
                            <span
                                    t-if="isRunContinuation(message, message_index)"
                                    class="sr-only"
                                >Mensagem de <t t-esc="authorLabel(message)" /> às <t
                                        t-esc="time(message.date)"
                                    /></span>
                            <t t-if="message.direction === 'inbound'">
                                <span
                                        t-if="!isRunContinuation(message, message_index)"
                                        class="cc-message__avatar cc-avatar"
                                        t-esc="initials(authorLabel(message))"
                                        aria-hidden="true"
                                    />
                                <span
                                        t-else=""
                                        class="cc-message__avatar-spacer"
                                        aria-hidden="true"
                                    />
                            </t>
                            <div class="cc-message__content">
                                <div
                                        t-if="!isRunContinuation(message, message_index)"
                                        class="cc-message__source"
                                    >
                                    <span t-esc="authorLabel(message)" />
                                    <small
                                            t-if="isGroupConversation &amp;&amp; message.direction === 'inbound'"
                                            class="cc-message__participant"
                                        >Participante</small>
                                    <small
                                            t-if="message.direction === 'internal'"
                                            class="cc-message__internal-label"
                                        ><i
                                                class="fa fa-lock"
                                                aria-hidden="true"
                                            /> Nota interna</small>
                                    <small t-else="">
                                        <span t-esc="message.platform" />
                                        <t
                                                t-if="message.provider &amp;&amp; message.provider !== 'internal'"
                                            > · <span t-esc="message.provider" /></t>
                                    </small>
                                </div>
                                <div class="cc-message__lane">
                                    <div class="cc-message__stack">
                                        <div class="cc-message__bubble">
                                            <div
                                                    t-if="isForwarded(message)"
                                                    class="cc-message-forwarded"
                                                >
                                                <i
                                                        class="fa fa-share"
                                                        aria-hidden="true"
                                                    />
                                                <span>Encaminhada</span>
                                            </div>
                                            <blockquote
                                                    t-if="message.reply_to"
                                                    class="cc-reply-preview"
                                                >
                                                <strong
                                                        t-esc="authorLabel(message.reply_to)"
                                                    />
                                                <span
                                                        t-esc="preview(message.reply_to)"
                                                    />
                                            </blockquote>
                                            <div
                                                    t-if="ui.editingId === message.message_id"
                                                    class="cc-message-edit"
                                                    t-on-click.stop="() => {}"
                                                >
                                                <label>
                                                    <span
                                                            class="sr-only"
                                                        >Editar mensagem</span>
                                                    <textarea
                                                            t-ref="editInput"
                                                            rows="3"
                                                            t-att-value="ui.editBody"
                                                            t-on-input="onEditInput"
                                                            t-on-keydown="(event) => this.onEditKeydown(event, message)"
                                                            t-att-disabled="isBusy(message)"
                                                        />
                                                </label>
                                                <div class="cc-message-edit__actions">
                                                    <button
                                                            type="button"
                                                            class="cc-message-action-button"
                                                            t-on-click="cancelEdit"
                                                            t-att-disabled="isBusy(message)"
                                                        >Cancelar</button>
                                                    <button
                                                            type="button"
                                                            class="cc-message-action-button is-primary"
                                                            t-on-click="() => this.saveEdit(message)"
                                                            t-att-disabled="!ui.editBody.trim() || ui.editBody.trim() === message.body_text.trim() || isBusy(message)"
                                                        >Salvar</button>
                                                </div>
                                            </div>
                                            <MessageContent
                                                    t-else=""
                                                    message="message"
                                                />
                                            <footer>
                                                <span
                                                        t-if="message.edited_at &amp;&amp; !message.is_deleted"
                                                        class="cc-message-edited"
                                                    >editada</span>
                                                <span
                                                        t-if="isGroupConversation &amp;&amp; message.direction === 'outbound' &amp;&amp; groupDelivery(message)"
                                                        class="cc-group-delivery"
                                                        t-att-title="groupDelivery(message)"
                                                        t-esc="groupDelivery(message)"
                                                    />
                                                <time t-esc="time(message.date)" />
                                                <span
                                                        t-if="message.direction === 'outbound'"
                                                        t-attf-class="cc-delivery-state cc-delivery-state--#{delivery(message).state || 'queued'}"
                                                        t-att-title="delivery(message).label"
                                                        t-esc="delivery(message).icon"
                                                    />
                                            </footer>
                                        </div>
                                        <div
                                                t-if="message.reactions &amp;&amp; message.reactions.length"
                                                class="cc-message-reactions"
                                                aria-label="Reações"
                                            >
                                            <button
                                                    t-foreach="message.reactions"
                                                    t-as="reaction"
                                                    t-key="reaction.emoji"
                                                    type="button"
                                                    t-att-class="reaction.reacted_by_me ? 'cc-reaction-chip is-mine' : 'cc-reaction-chip'"
                                                    t-att-disabled="!messageActionAllowed(message, 'react') || isBusy(message)"
                                                    t-att-aria-label="reactionLabel(message, reaction)"
                                                    t-on-click.stop="() => this.react(message, reaction.emoji)"
                                                >
                                                <span
                                                        t-esc="reaction.emoji"
                                                        aria-hidden="true"
                                                    />
                                                <small t-esc="reaction.count" />
                                            </button>
                                        </div>
                                        <div
                                                t-if="dispatchReason(message).label"
                                                t-attf-class="cc-message-dispatch-reason cc-message-dispatch-reason--#{dispatchReason(message).tone}"
                                            >
                                            <span
                                                    t-esc="dispatchReason(message).label"
                                                />
                                            <button
                                                    t-if="messageActionAllowed(message, 'resend')"
                                                    type="button"
                                                    class="cc-message-resend"
                                                    t-att-disabled="isBusy(message)"
                                                    t-on-click.stop="() => this.resend(message)"
                                                >
                                                <i
                                                        class="fa fa-repeat"
                                                        aria-hidden="true"
                                                    />
                                                <t
                                                        t-esc="isBusy(message) ? resendingLabel : resendLabel"
                                                    />
                                            </button>
                                        </div>
                                    </div>
                                    <t
                                            t-call="contact_center_ui.TimelineMessageActions"
                                        />
                                </div>
                            </div>
                        </article>
                    </t>
                    <button
                            t-if="state.timelineHasMoreForward"
                            type="button"
                            class="cc-load-newer"
                            t-att-disabled="state.timelinePhase === 'loading_newer'"
                            t-on-click="loadNewer"
                        >
                        <t
                                t-if="state.timelinePhase === 'loading_newer'"
                            >Carregando mensagens…</t>
                        <t t-else="">Ver mensagens mais recentes</t>
                    </button>
                </t>
                <span
                        t-if="state.messages.length"
                        t-ref="tail"
                        class="cc-timeline__end"
                        aria-hidden="true"
                    />
                </div>
            </section>
            <span class="sr-only" role="status" aria-live="polite" aria-atomic="true">
                <t t-if="ui.unseenMessages === 1">1 nova mensagem</t>
                <t t-elif="ui.unseenMessages"><t
                        t-esc="ui.unseenMessages"
                    /> novas mensagens</t>
            </span>
            <button
                t-if="ui.unseenMessages || ui.awayFromLatest"
                type="button"
                class="cc-new-messages"
                t-on-click="showLatest"
            >
                <i class="fa fa-angle-down" aria-hidden="true" />
                <t t-if="ui.unseenMessages === 1">1 nova mensagem</t>
                <t t-elif="ui.unseenMessages"><t
                        t-esc="ui.unseenMessages"
                    /> novas mensagens</t>
                <t t-else="">Ir ao fim</t>
            </button>
        </div>
    </t>
    <t t-name="contact_center_ui.TimelineMessageActions" owl="1">
        <div
            t-if="hasActions(message)"
            t-att-class="actionsClass(message)"
            t-on-click.stop="() => {}"
            t-on-keydown="onActionKeydown"
        >
            <button
                type="button"
                class="cc-message-actions__toggle"
                aria-haspopup="menu"
                t-att-aria-expanded="ui.openMenuId === message.message_id ? 'true' : 'false'"
                aria-label="Ações da mensagem"
                t-on-click="() => this.toggleMenu(message)"
            >
                <i class="fa fa-ellipsis-h" aria-hidden="true" />
            </button>
            <div
                t-if="ui.openMenuId === message.message_id"
                class="cc-message-menu"
                role="menu"
            >
                <button
                    t-if="messageActionAllowed(message, 'reply')"
                    type="button"
                    role="menuitem"
                    t-on-click="() => this.reply(message)"
                >
                    <i class="fa fa-reply" aria-hidden="true" />
                    Responder
                </button>
                <button
                    t-if="messageActionAllowed(message, 'react')"
                    type="button"
                    role="menuitem"
                    t-on-click="() => this.openReactionPicker(message)"
                >
                    <i class="fa fa-smile-o" aria-hidden="true" />
                    Reagir
                </button>
                <button
                    t-if="messageActionAllowed(message, 'edit')"
                    type="button"
                    role="menuitem"
                    t-on-click="() => this.startEdit(message)"
                >
                    <i class="fa fa-pencil" aria-hidden="true" />
                    Editar
                </button>
                <button
                    t-if="canViewSourceWebhook(message)"
                    type="button"
                    role="menuitem"
                    t-on-click="() => this.viewSourceWebhook(message)"
                >
                    <i class="fa fa-file-code-o" aria-hidden="true" />
                    Ver webhook de origem
                </button>
                <button
                    t-if="messageActionAllowed(message, 'delete')"
                    type="button"
                    role="menuitem"
                    class="is-danger"
                    t-on-click="() => this.askDelete(message)"
                >
                    <i class="fa fa-trash-o" aria-hidden="true" />
                    Apagar
                </button>
            </div>
            <div
                t-if="ui.reactionPickerId === message.message_id"
                t-ref="reactionPicker"
                class="cc-reaction-picker"
                role="group"
                aria-label="Escolher reação"
            >
                <button
                    t-foreach="quickReactions"
                    t-as="emoji"
                    t-key="emoji"
                    type="button"
                    t-att-aria-label="'Reagir com ' + emoji"
                    t-att-disabled="isBusy(message)"
                    t-on-click="() => this.react(message, emoji)"
                ><t t-esc="emoji" /></button>
            </div>
            <div
                t-if="ui.deletingId === message.message_id"
                t-ref="deleteConfirmation"
                class="cc-delete-confirmation"
                role="group"
                aria-label="Confirmar exclusão da mensagem"
            >
                <strong>Apagar para todos?</strong>
                <span>Esta ação não pode ser desfeita no canal externo.</span>
                <span
                    t-if="keepsDeletedMessageContent"
                >Nesta caixa, o conteúdo ficará visível e riscado.</span>
                <span
                    t-else=""
                >Nesta caixa, restará apenas o aviso de mensagem apagada.</span>
                <div>
                    <button
                        type="button"
                        t-on-click="closeActions"
                        t-att-disabled="isBusy(message)"
                    >Cancelar</button>
                    <button
                        type="button"
                        class="is-danger"
                        t-on-click="() => this.deleteMessage(message)"
                        t-att-disabled="isBusy(message)"
                    >Apagar</button>
                </div>
            </div>
        </div>
    </t>
</templates>
