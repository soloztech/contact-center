<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="contact_center_ui.MessageComposer" owl="1">
        <footer
            t-attf-class="cc-composer #{local.dragActive ? 'is-dragging' : ''} #{noteMode ? 'is-note-mode' : ''}"
            t-on-dragover="onDragOver"
            t-on-dragleave="onDragLeave"
            t-on-drop="onDrop"
        >
            <div t-if="local.dragActive" class="cc-composer-drop-target" role="status">
                <i class="fa fa-paperclip" aria-hidden="true" />
                <strong>Solte o arquivo para anexar</strong>
            </div>
            <nav
                t-if="hasProductivityToolbar &amp;&amp; !voiceCaptureActive"
                class="cc-productivity-toolbar"
                aria-label="Ferramentas da conversa"
            >
                <label
                    t-if="structuredTypes.length || local.structuredDraft"
                    class="cc-composer-card-choice"
                >
                    <span class="sr-only">Tipo de cartão</span>
                    <select
                        aria-label="Tipo de cartão"
                        t-att-disabled="!canChooseStructured"
                        t-on-change="onStructuredType"
                    >
                        <option
                            value=""
                            t-att-selected="!local.structuredDraft"
                        >Cartão…</option>
                        <option
                            t-if="local.structuredDraft &amp;&amp; !structuredTypes.includes(local.structuredDraft.type)"
                            t-att-value="local.structuredDraft.type"
                            selected="selected"
                            disabled="disabled"
                        ><t
                                t-esc="structuredLabel(local.structuredDraft.type)"
                            /> (indisponível)</option>
                        <option
                            t-foreach="structuredTypes"
                            t-as="type"
                            t-key="type"
                            t-att-value="type"
                            t-att-selected="local.structuredDraft &amp;&amp; local.structuredDraft.type === type"
                            t-esc="structuredLabel(type)"
                        />
                    </select>
                </label>
                <button
                    t-if="canUseQuickReplies"
                    type="button"
                    t-att-class="local.tool === 'quick_reply' ? 'is-active' : ''"
                    t-att-aria-expanded="local.tool === 'quick_reply' ? 'true' : 'false'"
                    aria-label="Abrir respostas rápidas"
                    title="Resposta rápida (Ctrl+Shift+Q)"
                    t-on-click="() => this.openTool('quick_reply')"
                >
                    <i class="fa fa-bolt" aria-hidden="true" />
                    <span>Resposta rápida</span>
                </button>
                <button
                    t-if="canUseInternalNotes"
                    type="button"
                    t-att-class="noteMode ? 'cc-productivity-note is-active' : 'cc-productivity-note'"
                    t-att-aria-pressed="noteMode ? 'true' : 'false'"
                    aria-label="Alternar nota interna"
                    title="Nota interna (Ctrl+Shift+N)"
                    t-on-click="toggleNoteMode"
                >
                    <i class="fa fa-sticky-note-o" aria-hidden="true" />
                    <span>Nota interna</span>
                </button>
                <button
                    t-if="canUseFollowups"
                    type="button"
                    t-att-class="local.tool === 'followup' ? 'is-active' : ''"
                    t-att-aria-expanded="local.tool === 'followup' ? 'true' : 'false'"
                    aria-label="Abrir follow-ups"
                    title="Follow-up (Ctrl+Shift+F)"
                    t-on-click="() => this.openTool('followup')"
                >
                    <i class="fa fa-clock-o" aria-hidden="true" />
                    <span>Follow-up</span>
                </button>
                <button
                    t-if="canUseScheduledMessages"
                    type="button"
                    t-att-class="local.tool === 'schedule' ? 'is-active' : ''"
                    t-att-aria-expanded="local.tool === 'schedule' ? 'true' : 'false'"
                    aria-label="Abrir mensagens agendadas"
                    title="Agendar mensagem (Ctrl+Shift+G)"
                    t-on-click="() => this.openTool('schedule')"
                >
                    <i class="fa fa-calendar" aria-hidden="true" />
                    <span>Agendar</span>
                </button>
            </nav>
            <section
                t-if="local.tool"
                class="cc-productivity-panel"
                t-att-aria-label="local.tool === 'quick_reply' ? 'Respostas rápidas' : local.tool === 'followup' ? 'Follow-ups' : 'Mensagens agendadas'"
            >
                <header class="cc-productivity-panel__header">
                    <strong>
                        <t t-if="local.tool === 'quick_reply'">Respostas rápidas</t>
                        <t t-elif="local.tool === 'followup'">Follow-ups</t>
                        <t t-else="">Agendar mensagem</t>
                    </strong>
                    <button
                        type="button"
                        class="cc-productivity-panel__close"
                        aria-label="Fechar ferramenta"
                        t-on-click="closeTool"
                    ><i class="fa fa-times" aria-hidden="true" /></button>
                </header>

                <t t-if="local.tool === 'quick_reply'">
                    <label class="cc-productivity-search">
                        <i class="fa fa-search" aria-hidden="true" />
                        <span class="sr-only">Buscar resposta rápida</span>
                        <input
                            t-ref="toolSearch"
                            type="search"
                            placeholder="Buscar atalho ou conteúdo"
                            t-att-value="local.quickReplyQuery"
                            t-on-input="onQuickReplySearch"
                        />
                    </label>
                    <div
                        t-if="quickReplies.phase === 'loading'"
                        class="cc-productivity-state"
                        aria-busy="true"
                    ><i
                            class="fa fa-circle-o-notch fa-spin"
                            aria-hidden="true"
                        /> Buscando…</div>
                    <div
                        t-elif="quickReplies.phase === 'error'"
                        class="cc-productivity-state is-error"
                        role="alert"
                    >
                        <span t-esc="quickReplies.error" />
                        <button
                            type="button"
                            t-on-click="retryActiveTool"
                        >Tentar novamente</button>
                    </div>
                    <div t-else="" class="cc-quick-reply-list">
                        <button
                            t-foreach="quickReplies.items"
                            t-as="reply"
                            t-key="reply.id"
                            type="button"
                            t-on-click="() => this.insertQuickReply(reply)"
                        >
                            <strong t-esc="reply.name" />
                            <small t-if="reply.description" t-esc="reply.description" />
                            <span t-esc="reply.body" />
                        </button>
                        <p
                            t-if="!quickReplies.items.length"
                        >Nenhuma resposta rápida encontrada.</p>
                    </div>
                </t>

                <t t-elif="local.tool === 'followup'">
                    <div
                        t-if="productivity.phase === 'loading'"
                        class="cc-productivity-state"
                        aria-busy="true"
                    ><i
                            class="fa fa-circle-o-notch fa-spin"
                            aria-hidden="true"
                        /> Carregando…</div>
                    <div
                        t-elif="productivity.phase === 'error'"
                        class="cc-productivity-state is-error"
                        role="alert"
                    >
                        <span t-esc="productivity.error" />
                        <button
                            type="button"
                            t-on-click="retryActiveTool"
                        >Tentar novamente</button>
                    </div>
                    <t t-else="">
                        <div class="cc-followup-form">
                            <label
                                class="cc-productivity-field cc-productivity-field--grow"
                            >
                                <span>Resumo</span>
                                <input
                                    type="text"
                                    placeholder="Ex.: Retornar orçamento"
                                    t-att-value="local.followupSummary"
                                    t-on-input="(event) => this.onFollowupField('followupSummary', event)"
                                />
                            </label>
                            <label class="cc-productivity-field">
                                <span>Data</span>
                                <input
                                    type="date"
                                    t-att-min="minimumFollowupDate"
                                    t-att-value="local.followupDate"
                                    t-on-input="(event) => this.onFollowupField('followupDate', event)"
                                />
                            </label>
                            <label
                                t-if="productivity.activityTypes.length"
                                class="cc-productivity-field"
                            >
                                <span>Tipo</span>
                                <select
                                    t-on-change="(event) => this.onFollowupField('followupActivityTypeId', event)"
                                >
                                    <option
                                        t-foreach="productivity.activityTypes"
                                        t-as="activityType"
                                        t-key="activityType.id"
                                        t-att-value="activityType.id"
                                        t-att-selected="local.followupActivityTypeId === activityType.id"
                                    ><t t-esc="activityType.name" /></option>
                                </select>
                            </label>
                            <label
                                t-if="productivity.assignableUsers.length"
                                class="cc-productivity-field"
                            >
                                <span>Responsável</span>
                                <select
                                    t-on-change="(event) => this.onFollowupField('followupUserId', event)"
                                >
                                    <option value="">Padrão</option>
                                    <option
                                        t-foreach="productivity.assignableUsers"
                                        t-as="user"
                                        t-key="user.id"
                                        t-att-value="user.id"
                                        t-att-selected="local.followupUserId === user.id"
                                    ><t t-esc="user.name" /></option>
                                </select>
                            </label>
                            <label
                                t-if="productivity.cases.length &gt; 1"
                                class="cc-productivity-field"
                            >
                                <span>Caso</span>
                                <select
                                    t-on-change="(event) => this.onFollowupField('followupCaseId', event)"
                                >
                                    <option value="">Caso padrão</option>
                                    <option
                                        t-foreach="productivity.cases"
                                        t-as="caseItem"
                                        t-key="caseItem.id"
                                        t-att-value="caseItem.id"
                                        t-att-selected="local.followupCaseId === caseItem.id"
                                    ><t t-esc="caseItem.name" /></option>
                                </select>
                            </label>
                            <label
                                class="cc-productivity-field cc-productivity-field--wide"
                            >
                                <span>Observação opcional</span>
                                <input
                                    type="text"
                                    t-att-value="local.followupNote"
                                    t-on-input="(event) => this.onFollowupField('followupNote', event)"
                                />
                            </label>
                            <button
                                type="button"
                                class="cc-productivity-primary"
                                t-att-disabled="local.actionBusy"
                                t-on-click="createFollowup"
                            >Criar follow-up</button>
                        </div>
                        <div
                            class="cc-productivity-items"
                            aria-label="Follow-ups em aberto"
                        >
                            <article
                                t-foreach="productivity.activities"
                                t-as="activity"
                                t-key="activity.id"
                                t-attf-class="cc-productivity-item is-#{activity.state || 'planned'}"
                            >
                                <div>
                                    <strong t-esc="activity.summary" />
                                    <small>
                                        <t t-esc="activity.date_deadline" />
                                        <t t-if="activity.assigned_to"> · <t
                                                t-esc="activity.assigned_to.name"
                                            /></t>
                                        <t t-if="activity.case_name"> · <t
                                                t-esc="activity.case_name"
                                            /></t>
                                    </small>
                                </div>
                                <div
                                    t-if="activity.can_complete"
                                    class="cc-productivity-item__actions"
                                >
                                    <input
                                        type="text"
                                        placeholder="Resultado (opcional)"
                                        t-att-value="local.completionFeedback[activity.id] || ''"
                                        t-on-input="(event) => this.onCompletionFeedback(activity.id, event)"
                                    />
                                    <button
                                        type="button"
                                        t-att-disabled="local.actionBusy"
                                        t-on-click="() => this.completeFollowup(activity.id)"
                                    ><i
                                            class="fa fa-check"
                                            aria-hidden="true"
                                        /> Concluir</button>
                                </div>
                            </article>
                            <p
                                t-if="!productivity.activities.length"
                            >Nenhum follow-up em aberto.</p>
                        </div>
                    </t>
                </t>

                <t t-else="">
                    <div
                        t-if="productivity.phase === 'loading'"
                        class="cc-productivity-state"
                        aria-busy="true"
                    ><i
                            class="fa fa-circle-o-notch fa-spin"
                            aria-hidden="true"
                        /> Carregando…</div>
                    <div
                        t-elif="productivity.phase === 'error'"
                        class="cc-productivity-state is-error"
                        role="alert"
                    >
                        <span t-esc="productivity.error" />
                        <button
                            type="button"
                            t-on-click="retryActiveTool"
                        >Tentar novamente</button>
                    </div>
                    <t t-else="">
                        <div class="cc-schedule-form">
                            <p
                                t-if="canCreateScheduledMessage"
                            >O texto atual será enviado automaticamente pela caixa desta conversa.</p>
                            <p
                                t-else=""
                                class="cc-schedule-form__warning"
                                role="status"
                            ><i
                                    class="fa fa-info-circle"
                                    aria-hidden="true"
                                /> Esta conversa está somente para recebimento. Você ainda pode consultar ou cancelar agendamentos existentes.</p>
                            <label class="cc-productivity-field">
                                <span>Enviar em</span>
                                <input
                                    type="datetime-local"
                                    t-att-min="minimumScheduledAt"
                                    t-att-max="maximumScheduledAt"
                                    t-att-value="local.scheduledAt"
                                    t-att-disabled="!scheduledTextOnlyAllowed || local.actionBusy"
                                    t-on-input="onScheduledAtInput"
                                />
                            </label>
                            <button
                                type="button"
                                class="cc-productivity-primary"
                                t-att-disabled="!canScheduleCurrentMessage"
                                t-on-click="scheduleCurrentMessage"
                            >Agendar texto</button>
                        </div>
                        <div
                            class="cc-productivity-items"
                            aria-label="Mensagens agendadas"
                        >
                            <article
                                t-foreach="productivity.scheduledMessages"
                                t-as="scheduled"
                                t-key="scheduled.id"
                                t-attf-class="cc-productivity-item cc-productivity-item--schedule is-#{scheduledStateMeta(scheduled.state).key}"
                            >
                                <div>
                                    <div class="cc-productivity-item__heading">
                                        <strong t-esc="scheduled.body" />
                                        <span
                                            t-attf-class="cc-scheduled-state is-#{scheduledStateMeta(scheduled.state).key}"
                                        ><i
                                                t-att-class="scheduledStateMeta(scheduled.state).icon"
                                                aria-hidden="true"
                                            /> <t
                                                t-esc="scheduledStateMeta(scheduled.state).label"
                                            /></span>
                                    </div>
                                    <small>
                                        <i
                                            class="fa fa-calendar-o"
                                            aria-hidden="true"
                                        /> <t
                                            t-esc="scheduledDateLabel(scheduled.scheduled_at)"
                                        />
                                        <t
                                            t-if="scheduled.requested_by &amp;&amp; scheduled.requested_by.name"
                                        > · <t
                                                t-esc="scheduled.requested_by.name"
                                            /></t>
                                    </small>
                                    <small
                                        t-if="scheduledErrorLabel(scheduled)"
                                        class="cc-scheduled-error"
                                        role="alert"
                                    ><i
                                            class="fa fa-exclamation-triangle"
                                            aria-hidden="true"
                                        /> <t
                                            t-esc="scheduledErrorLabel(scheduled)"
                                        /></small>
                                </div>
                                <button
                                    t-if="scheduled.can_cancel"
                                    type="button"
                                    t-att-disabled="local.actionBusy"
                                    t-on-click="() => this.cancelScheduledMessage(scheduled.id)"
                                >Cancelar</button>
                            </article>
                            <p
                                t-if="!productivity.scheduledMessages.length"
                            >Nenhuma mensagem agendada.</p>
                        </div>
                    </t>
                </t>
            </section>
            <div t-if="state.replyTo" class="cc-composer__reply">
                <i class="fa fa-reply" aria-hidden="true" />
                <div>
                    <strong>Respondendo a <span t-esc="replyAuthorLabel()" /></strong>
                    <span t-esc="replyPreview()" />
                </div>
                <button
                    t-if="!noteMode"
                    type="button"
                    aria-label="Cancelar resposta"
                    t-att-disabled="local.sendPlan || local.actionBusy"
                    t-on-click="() => store.clearReply()"
                >
                    <i class="fa fa-times" aria-hidden="true" />
                </button>
            </div>
            <t
                t-if="local.structuredDraft"
                t-call="contact_center_ui.StructuredComposerFields"
            />
            <div t-if="attachments.length" class="cc-composer-attachments">
            <div
                    t-foreach="attachments"
                    t-as="attachment"
                    t-key="attachment.id"
                    t-att-class="'cc-composer-attachment is-' + attachment.phase"
                    t-att-aria-busy="attachment.phase === 'uploading' ? 'true' : 'false'"
                >
                <div class="cc-composer-attachment__preview" aria-hidden="true">
                    <img
                            t-if="attachment.kind === 'image' &amp;&amp; attachment.previewUrl"
                            t-att-src="attachment.previewUrl"
                            alt=""
                        />
                    <video
                            t-elif="attachment.kind === 'video' &amp;&amp; attachment.previewUrl"
                            t-att-src="attachment.previewUrl"
                            muted="muted"
                            playsinline="playsinline"
                        />
                    <i
                            t-else=""
                            t-att-class="attachment.kind === 'audio' ? 'fa fa-volume-up' : 'fa fa-file-o'"
                        />
                </div>
                <div class="cc-composer-attachment__copy">
                    <strong t-esc="attachment.name" />
                    <span
                            t-if="attachment.phase === 'uploading' || attachment.phase === 'pending'"
                        >
                        <i class="fa fa-circle-o-notch fa-spin" aria-hidden="true" />
                        Preparando arquivo…
                    </span>
                    <span t-elif="attachment.phase === 'error'" class="is-error">
                        <i class="fa fa-exclamation-circle" aria-hidden="true" />
                        <t t-esc="attachment.error" />
                    </span>
                    <span t-else="" t-esc="attachmentLabel(attachment)" />
                    <audio
                            t-if="attachment.kind === 'audio' &amp;&amp; attachment.previewUrl"
                            class="cc-composer-attachment__audio"
                            t-att-src="attachment.previewUrl"
                            controls="controls"
                            controlslist="nodownload"
                            preload="metadata"
                            aria-label="Ouvir prévia do áudio"
                        />
                    <button
                            t-if="attachment.phase === 'error'"
                            type="button"
                            class="cc-composer-attachment__retry"
                            t-att-disabled="uploadInProgress || local.sendPlan || local.actionBusy"
                            t-on-click="() => this.retryUpload(attachment)"
                        >Tentar novamente</button>
                </div>
                <button
                        type="button"
                        class="cc-composer-attachment__remove"
                        aria-label="Remover arquivo"
                        title="Remover arquivo"
                        t-att-disabled="local.sendPlan || local.actionBusy"
                        t-on-click="() => this.removeAttachment(attachment)"
                    >
                    <i class="fa fa-times" aria-hidden="true" />
                </button>
            </div>
            </div>
            <p
                t-if="attachments.length"
                class="cc-composer-attachments__hint"
                t-esc="attachmentCaptionHint"
            />
            <div t-if="local.sendStatus" class="cc-composer-upload-error" role="status">
                <i class="fa fa-info-circle" aria-hidden="true" />
                <span t-esc="local.sendStatus" />
            </div>
            <div t-if="local.uploadError" class="cc-composer-upload-error" role="alert">
                <i class="fa fa-exclamation-circle" aria-hidden="true" />
                <span t-esc="local.uploadError" />
                <button
                    type="button"
                    t-on-click="chooseAttachment"
                >Escolher outro</button>
                <button
                    type="button"
                    class="cc-composer-upload-error__dismiss"
                    aria-label="Fechar aviso"
                    title="Fechar aviso"
                    t-on-click="() => this.removeAttachment()"
                >
                    <i class="fa fa-times" aria-hidden="true" />
                </button>
            </div>
            <div
                t-if="local.recordingError"
                class="cc-composer-upload-error"
                role="alert"
            >
                <i class="fa fa-exclamation-circle" aria-hidden="true" />
                <span t-esc="local.recordingError" />
                <button
                    type="button"
                    class="cc-composer-upload-error__dismiss"
                    aria-label="Fechar aviso de gravação"
                    title="Fechar aviso"
                    t-on-click="dismissVoiceRecordingError"
                >
                    <i class="fa fa-times" aria-hidden="true" />
                </button>
            </div>
            <div
                t-if="voiceCaptureActive"
                class="cc-voice-recorder"
                t-att-class="'cc-voice-recorder is-' + local.recordingPhase"
            >
                <button
                    t-ref="voiceCancel"
                    type="button"
                    class="cc-voice-recorder__cancel"
                    aria-label="Cancelar e descartar gravação"
                    title="Cancelar gravação"
                    t-on-click="cancelVoiceRecording"
                >
                    <i class="fa fa-trash-o" aria-hidden="true" />
                </button>
                <span class="cc-voice-recorder__pulse" aria-hidden="true" />
                <div class="cc-voice-recorder__status">
                    <strong t-esc="voiceRecordingStatus" />
                    <span
                        class="sr-only"
                        aria-live="polite"
                        t-esc="voiceRecordingStatus"
                    />
                    <small t-esc="voiceRecordingLimit" />
                </div>
                <time
                    class="cc-voice-recorder__time"
                    aria-label="Tempo gravado"
                    t-esc="voiceRecordingTime"
                />
                <button
                    type="button"
                    class="cc-voice-recorder__stop"
                    t-att-disabled="local.recordingPhase !== 'recording'"
                    aria-label="Parar e preparar gravação de áudio"
                    title="Concluir gravação"
                    t-on-click="stopVoiceRecording"
                >
                    <i
                        t-if="local.recordingPhase === 'processing'"
                        class="fa fa-circle-o-notch fa-spin"
                        aria-hidden="true"
                    />
                    <i t-else="" class="fa fa-stop" aria-hidden="true" />
                </button>
            </div>
            <div t-else="" class="cc-composer__row">
                <input
                    t-ref="file"
                    type="file"
                    multiple="multiple"
                    class="cc-composer__file-input"
                    t-att-accept="acceptedFiles"
                    tabindex="-1"
                    t-on-change="onFileChange"
                />
                <button
                    t-if="!noteMode"
                    type="button"
                    class="cc-attachment-button"
                    t-att-disabled="!canChooseAttachments"
                    t-att-title="scheduleMode ? 'Agendamento aceita somente texto' : canAttach ? 'Anexar até 10 arquivos' : 'Este canal não permite anexos'"
                    aria-label="Anexar arquivos"
                    t-on-click="chooseAttachment"
                >
                    <i class="fa fa-paperclip" aria-hidden="true" />
                </button>
                <div class="cc-composer__field">
                    <textarea
                        t-ref="input"
                        rows="1"
                        t-att-maxlength="bodyMaxLength"
                        t-att-placeholder="noteMode ? 'Escreva uma nota interna' : attachments.length ? 'Adicione uma legenda ou mensagem' : 'Escreva uma mensagem'"
                        t-att-aria-label="noteMode ? 'Nota interna' : 'Mensagem'"
                        t-att-value="local.body"
                        t-att-readonly="local.sendPlan ? true : false"
                        t-att-disabled="!conversation || (!noteMode &amp;&amp; !conversation.can_send) || voiceCaptureActive"
                        t-on-input="onInput"
                        t-on-keydown="onKeydown"
                        t-on-paste="onPaste"
                    />
                    <span class="cc-composer__hint" t-esc="composerHint" />
                </div>
                <button
                    t-if="showVoiceRecordingButton"
                    type="button"
                    class="cc-voice-record-button"
                    t-att-disabled="!canStartVoiceRecording"
                    t-att-title="canStartVoiceRecording ? 'Gravar áudio' : 'A gravação não está disponível agora'"
                    aria-label="Gravar áudio"
                    t-on-click="startVoiceRecording"
                >
                    <i class="fa fa-microphone" aria-hidden="true" />
                </button>
                <button
                    t-else=""
                    type="button"
                    t-att-class="noteMode ? 'cc-send-button is-note' : scheduleMode ? 'cc-send-button is-schedule' : 'cc-send-button'"
                    t-att-disabled="!primaryActionAvailable"
                    t-att-title="primaryActionTitle"
                    t-on-click="runPrimaryAction"
                >
                    <span
                        t-if="sending"
                        class="cc-send-button__spinner"
                        aria-hidden="true"
                    />
                    <i
                        t-else=""
                        t-att-class="noteMode ? 'fa fa-sticky-note' : scheduleMode ? 'fa fa-clock-o' : 'fa fa-paper-plane'"
                        aria-hidden="true"
                    />
                    <span class="sr-only"><t
                            t-if="noteMode"
                        >Registrar nota interna</t><t
                            t-elif="scheduleMode"
                        >Agendar mensagem</t><t t-else="">Enviar mensagem</t></span>
                </button>
            </div>
        </footer>
    </t>
    <t t-name="contact_center_ui.StructuredComposerFields" owl="1">
        <fieldset
            class="cc-structured-form"
            t-att-disabled="local.sendPlan || local.actionBusy || !structuredSpec"
        >
            <legend t-esc="structuredLabel(local.structuredDraft.type)" />
            <p
                t-if="structuredBodyHint"
                class="cc-structured-form__hint"
                t-esc="structuredBodyHint"
            />
            <t t-if="['buttons', 'list'].includes(local.structuredDraft.type)">
                <label
                    t-if="!structuredSpec || structuredSpec.max_title_length || local.structuredDraft.title"
                ><span>Título (opcional)</span><input
                        type="text"
                        t-att-maxlength="structuredSpec &amp;&amp; structuredSpec.max_title_length * 2"
                        t-model="local.structuredDraft.title"
                    /></label>
                <label
                    t-if="!structuredSpec || structuredSpec.max_footer_length || local.structuredDraft.footer"
                ><span>Rodapé (opcional)</span><input
                        type="text"
                        t-att-maxlength="structuredSpec &amp;&amp; structuredSpec.max_footer_length * 2"
                        t-model="local.structuredDraft.footer"
                    /></label>
                <t t-if="local.structuredDraft.type === 'list'">
                    <label><span>Texto do botão</span><input
                            type="text"
                            t-att-maxlength="structuredSpec &amp;&amp; structuredSpec.max_button_text_length * 2"
                            t-model="local.structuredDraft.buttonText"
                        /></label>
                    <label><span>Nome da seção</span><input
                            type="text"
                            t-att-maxlength="structuredSpec &amp;&amp; structuredSpec.max_section_title_length * 2"
                            t-model="local.structuredDraft.sectionTitle"
                        /></label>
                </t>
                <div
                    t-foreach="local.structuredDraft.rows"
                    t-as="row"
                    t-key="row.id"
                    class="cc-structured-form__row"
                >
                    <label><span t-esc="'Opção ' + (row_index + 1)" /><input
                            type="text"
                            t-att-maxlength="structuredRowTitleLimit * 2"
                            t-model="row.title"
                        /></label>
                    <t t-if="local.structuredDraft.type === 'buttons'">
                        <label><span>Ação</span><select t-model="row.type">
                            <option
                                    t-if="!structuredActions.includes(row.type)"
                                    t-att-value="row.type"
                                    disabled="disabled"
                                ><t
                                        t-esc="structuredActionLabel(row.type)"
                                    /> (indisponível)</option>
                            <option
                                    t-foreach="structuredActions"
                                    t-as="action"
                                    t-key="action"
                                    t-att-value="action"
                                    t-esc="structuredActionLabel(action)"
                                />
                        </select></label>
                        <label t-if="row.type === 'url'"><span
                            >Endereço HTTPS</span><input
                                type="url"
                                maxlength="2048"
                                placeholder="https://"
                                t-model="row.url"
                            /></label>
                        <label t-if="row.type === 'phone'"><span>Telefone</span><input
                                type="tel"
                                t-att-maxlength="structuredSpec &amp;&amp; structuredSpec.max_phone_length"
                                placeholder="+55…"
                                t-model="row.phone"
                            /></label>
                    </t>
                    <label
                        t-elif="!structuredSpec || structuredSpec.max_row_description_length || row.description"
                    ><span>Descrição (opcional)</span><input
                            type="text"
                            t-att-maxlength="structuredSpec &amp;&amp; structuredSpec.max_row_description_length * 2"
                            t-model="row.description"
                        /></label>
                    <button
                        type="button"
                        title="Remover opção"
                        aria-label="Remover opção"
                        t-att-disabled="local.structuredDraft.rows.length === 1"
                        t-on-click="() => this.removeStructuredRow(row)"
                    ><i class="fa fa-times" aria-hidden="true" /></button>
                </div>
                <button
                    type="button"
                    class="cc-structured-form__add"
                    t-att-disabled="!canAddStructuredRow"
                    t-on-click="addStructuredRow"
                >Adicionar opção<t t-if="structuredRowLimit"> (até <t
                            t-esc="structuredRowLimit"
                        />)</t></button>
            </t>
            <t t-elif="local.structuredDraft.type === 'contacts'">
                <label><span>Nome do contato</span><input
                        type="text"
                        t-att-maxlength="structuredSpec &amp;&amp; structuredSpec.max_name_length * 2"
                        t-model="local.structuredDraft.name"
                    /></label>
                <label
                    t-if="!structuredSpec || structuredSpec.max_phones || local.structuredDraft.phones"
                ><span
                        t-esc="structuredSpec ? 'Telefones (até ' + structuredSpec.max_phones + ', um por linha)' : 'Telefones'"
                    /><textarea
                        rows="2"
                        t-att-maxlength="structuredSpec &amp;&amp; structuredSpec.max_phones * (structuredSpec.max_phone_length + 1)"
                        t-model="local.structuredDraft.phones"
                        placeholder="+55…"
                    /></label>
                <label
                    t-if="!structuredSpec || structuredSpec.max_emails || local.structuredDraft.emails"
                ><span
                        t-esc="structuredSpec ? 'E-mails (até ' + structuredSpec.max_emails + ', um por linha)' : 'E-mails'"
                    /><textarea
                        rows="2"
                        t-att-maxlength="structuredSpec &amp;&amp; structuredSpec.max_emails * (structuredSpec.max_email_length * 2 + 1)"
                        t-model="local.structuredDraft.emails"
                    /></label>
            </t>
            <t t-elif="local.structuredDraft.type === 'location'">
                <label
                    t-if="!structuredSpec || structuredSpec.max_name_length || local.structuredDraft.name"
                ><span>Nome do local (opcional)</span><input
                        type="text"
                        t-att-maxlength="structuredSpec &amp;&amp; structuredSpec.max_name_length * 2"
                        t-model="local.structuredDraft.name"
                    /></label>
                <label
                    t-if="!structuredSpec || structuredSpec.max_address_length || local.structuredDraft.address"
                ><span>Endereço (opcional)</span><input
                        type="text"
                        t-att-maxlength="structuredSpec &amp;&amp; structuredSpec.max_address_length * 2"
                        t-model="local.structuredDraft.address"
                    /></label>
                <label><span>Latitude</span><input
                        type="text"
                        inputmode="decimal"
                        placeholder="-23.5505"
                        t-model="local.structuredDraft.latitude"
                    /></label>
                <label><span>Longitude</span><input
                        type="text"
                        inputmode="decimal"
                        placeholder="-46.6333"
                        t-model="local.structuredDraft.longitude"
                    /></label>
            </t>
            <p
                t-if="structuredSubmission.error"
                class="cc-structured-form__hint"
                t-esc="structuredSubmission.error"
            />
        </fieldset>
    </t>
</templates>
